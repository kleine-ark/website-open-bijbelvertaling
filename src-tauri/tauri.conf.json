{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Vertaling",
  "version": "0.21.0",
  "identifier": "nl.openvertaling.osv",
  "build": {
    "frontendDist": "../desktop/dist",
    "beforeBuildCommand": "node desktop/build-dist.mjs",
    "beforeDevCommand": "node desktop/build-dist.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Open Vertaling",
        "width": 1100,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Open Vertaling — vrije herziening van de Statenvertaling",
    "longDescription": "Een vrij beschikbare herziening van de Statenvertaling (1637/1888) in leesbaar hedendaags Nederlands. Volledig offline te lezen, met grondtekst, kanttekeningen, citaatopmaak en onderwerpen.",
    "homepage": "https://openvertaling.nl",
    "publisher": "De Kleine Ark",
    "copyright": "Bijbeltekst: publiek domein (CC0)",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
