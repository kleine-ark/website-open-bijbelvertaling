        },
        {
          "woord": "ኅሩያን",
          "transliteratie": "ḫǝruyanǝ"
        }
      ]
    },
    {
      "number": 2,
      "text1637": "",
      "text2026": "Zalig bent u, rechtvaardigen en uitverkorenen, want heerlijk zal uw deel zijn.",
