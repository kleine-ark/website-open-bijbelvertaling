    {
      "nummer": 4,
      "tekst": "Daarna blijft zij nog drieëndertig dagen in haar reinigingsperiode vanwege het bloedverlies. In die tijd mag zij niets heiligs aanraken en niet naar het heiligdom gaan. Dit duurt totdat haar reinigingsperiode voorbij is.",
      "bron": {
        "bestand": "data/leviticus/12.json",
        "vers": 4,
        "tekstveld": "textSV1888"
      },
      "segmenten": [
        {
          "id": "LEV.12.4.s1",
          "tekst": "Daarna blijft zij nog drieëndertig dagen in haar reinigingsperiode vanwege het bloedverlies. In die tijd mag zij niets heiligs aanraken en niet naar het heiligdom gaan. Dit duurt totdat haar reinigingsperiode voorbij is.",
          "bronfrase": "Daarna zal zij drie en dertig dagen blijven in het bloed harer reiniging; niets heiligs zal zij aanroeren, en tot het heiligdom zal zij niet komen, totdat de dagen harer reiniging vervuld zijn."
        }
      ],
