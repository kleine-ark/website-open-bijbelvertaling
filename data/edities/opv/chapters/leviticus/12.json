    {
      "nummer": 7,
      "tekst": "De priester biedt deze offers aan voor de HEERE en doet verzoening voor haar. Zo wordt zij rein van haar bloedvloeiing. Dit is de regeling voor een vrouw die een zoon of dochter heeft gebaard.",
      "bron": {
        "bestand": "data/leviticus/12.json",
        "vers": 7,
        "tekstveld": "textSV1888"
      },
      "segmenten": [
        {
          "id": "LEV.12.7.s1",
          "tekst": "De priester biedt deze offers aan voor de HEERE en doet verzoening voor haar. Zo wordt zij rein van haar bloedvloeiing. Dit is de regeling voor een vrouw die een zoon of dochter heeft gebaard.",
          "bronfrase": "Die zal dat offeren voor het aangezicht des HEEREN, en zal voor haar verzoening doen, zo zal zij rein zijn van den vloed haars bloeds. Dit is de wet dergene, die een knechtje of meisje gebaard heeft."
        }
