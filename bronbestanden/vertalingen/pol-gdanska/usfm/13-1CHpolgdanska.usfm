\id 1CH
\h I Chronicles
\toc1 I Chronicles
\c 1
\v 1 Adam, Set, Enos.
\v 2 Kienan, Mahalaleel, Jared.
\v 3 Eonch, Matusalem, Lamech.
\v 4 Noe, Sem, Cham, i Jafet.
\v 5 Synowie Jafetowi: Gomer, i Magog, i Madaj, i Jawan, i Tubal, i Mesech, i Tyras,
\v 6 A synowie Gomerowi: Aschenaz, i Ryfat, i Togorma.
\v 7 Synowie też Jawanowi: Elisa, i Tarsys, Cytym, i Dodanin.
\v 8 Synowie Chamowi: Chus i Misraim, Put i Chanaan.
\v 9 A synowie Chusowi: Seba, i Hewila, i Sabta, i Regma, i Sabtacha; a synowie Regmy: Seba i Dedan.
\v 10 Spłodził też Chus Neroda; ten począł być możnym na ziemi.
\v 11 Misraim też spłodził Ludyma, i Hananima, i Laubima, i Naftuhyma,
\v 12 I Patrusyma, i Chasłuchyma, (z których poszli Filistynowie) i Kaftoryma.
\v 13 Potem Chanaan spłodził Sydona, pierworodnego swego, i Hetejczyka.
\v 14 I Jebuzejczyka, i Amorejczyka, i Giergiezejczyka,
\v 15 I Hewejczyka, i Archajczyka, i Symejczyka,
\v 16 I Aradejczyka, i Samarejczyka, i Chamatejczyka.
\v 17 Synowie Semowi: Elam, i Assur, i Arfachsad, i Lud, i Aram, i Chus, i Hul, i Gieter, i Mesech.
\v 18 A Arfachsad spłodził Selecha, a Selech spłodził Hebera.
\v 19 A Heberowi urodzili się dwaj synowie, z których jednemu imię było Faleg, przeto, że za jego czasów rozdzielona jest ziemia; a imię brata jego Jektan.
\v 20 A Jektan spłodził Elmodada, i Salefa, i Hassarmota, i Jarecha,
\v 21 I Adorama, i Uzala, i Dekla,
\v 22 I Hebala, i Abimaela, i Sebaja,
\v 23 I Ofira, i Hewila, i Jobaba. Ci wszyscy byli synowie Jektanowi.
\v 24 Sem, Arfachsad, Selech.
\v 25 Heber, Peleg, Rechu,
\v 26 Sarug, Nachor, Tare,
\v 27 Abram; ten jest Abraham.
\v 28 Synowie Abrahamowi: Izaak i Ismael.
\v 29 A teć są rodzaje ich: Pierworodny Ismaelowy Nebajot, i Kiedar, i Abdeel, i Mabsam.
\v 30 Masma, i Duma, Massa, Hadad, i Tema,
\v 31 Jetur, Nafis i Kiedma. Cić są synowie Ismaelowi.
\v 32 A synowie Cetury, założnicy Abrahamowej, których porodziła: Zamram i Joksan, i Madan, i Midyjan, i Jesbok, i Suach. A synowie Joksanowi; Saba i Dedan.
\v 33 Synowie też Madyjanowi: Hefa, i Hefer, i Henoch, i Abida, i Eldaa. Cić wszyscy są synowie Cetury.
\v 34 I spłodził Abraham Izaaka. A synowie Izaakowi byli: Ezaw i Izrael.
\v 35 A synowie Ezawowi: Elifas, Rehuel, i Jehus, i Jelom, i Kore.
\v 36 Synowie Elifasowi: Teman i Omar, Sefo i Gaatan, Kienaz i syn Tamny, to jest, Amalek.
\v 37 Synowie Rehuelowi: Nahat, Zara, Samma, i Meza.
\v 38 A synowie Seirowi: Lotan, i Sobal, i Sebeon, i Hana, i Dysson, i Eser, i Dysan.
\v 39 A synowie Lotanowi: Chory, i Heman; a siostra Lotanowa była Tamna.
\v 40 Synowie Sobalowi: Halman, i Manaat, i Hewal, Sefo, i Onam; a synowie Sebeonowi: Ajai Ana.
\v 41 Synowie Ana: Dyson; a synowie Dysona: Hamdan, i Eseban, i Jetran, i Charan.
\v 42 Synowie Eserowi: Balaan, i Zawan, Akan. Synowie Dysanowi: Hus i Aran.
\v 43 Cić są królowie, którzy królowali w ziemi Edomskiej, przedtem niż królował król nad synami Izraelskimi: Bela, syn Beorowy, a imię miasta jego Dynhaba.
\v 44 A gdy umarł Bela, królował miasto niego Jobab, syn Zerachowy z Bosry.
\v 45 A gdy umarł Jobab, królował miasto niego Chusam z ziemi Temańskiej.
\v 46 A gdy umarł Chusam, królował miasto niego Hadad, syn Badadowy, który poraził Madyjańczyków na polu Moabskiem; a imię miasta jego Hawid.
\v 47 A gdy umarł Hadad, królował miasto niego Samla z Masreki.
\v 48 A gdy umarł Samla, królował miasto niego Saul z Rechobot nad rzeką
\v 49 A gdy umarł Saul, królował miasto niego Balanan, syn Achoborowy.
\v 50 A gdy umarł Balanan, królował miasto niego Hadar; a imię miasta jego Pehu, imię też żony jego Mehetabel, córka Matredy, córki Mezaabowej.
\v 51 A gdy umarł Hadar, byli książętami w Edon: książę Tamna, książę Halwa, książę Jetet,
\v 52 Książę Oolibama, książę Ela, książę Pinon,
\v 53 Książę Kienaz, książę Teman, książę Mabsar,
\v 54 Książę Magdyjel, książę Hyram. Toć byli książęta Edomscy.
\c 2
\v 1 Cić są synowie Izraelowi: Ruben, Symeon, Lewi, i Juda, Isaschar i Zabulon,
\v 2 Dan, Józef, i Benjamin, Neftali, Gad i Aser.
\v 3 Synowie Judy: Her, i Onan, i Sela. Ci trzej urodzili mu się z córki Sui Chananejskiej. Ale Her, pierworodny Judy, był złym przed oczyma Pańskiemi; przetoż go zabił.
\v 4 Tamar zasię, niewiastka jego, urodziła mu Faresa i Zarę. Wszystkich synów Judowych pięć.
\v 5 Synowie Faresowi: Hesron i Hamuel.
\v 6 Synowie zaś Zary: Zamry, i Etan, i Heman, i Chalkol, i Darda; wszystkich tych było pięć.
\v 7 Asynowie Zamrego: Charmi, wnuk Acharowy, który zamięszanie uczynił w Izraelu, zgrzeszywszy kradzieżą rzeczy przeklętych.
\v 8 Asynowie Etanowi: Azaryjasz.
\v 9 A synowie Esronowi, którzy mu się urodzili: Jerameel, i Ram, i Chalubaj.
\v 10 Ale Ram spłodził Aminadaba, a Aminadab spłodził Naasona, książęcia synów Judzkich.
\v 11 A Naason spłodził Salmona, a Salmon spłodził Booza.
\v 12 A Booz spłodził Obeda, a Obed spłodził Isajego.
\v 13 A Isaj spłodził pierworodnego swego Elijaba, i Abinadaba wtórego, i Samma trzeciego.
\v 14 Natanaela czwartego, Raddaja piątego.
\v 15 Ozema szóstego, Dawida siódmego.
\v 16 A siostry ich: Sareija, i Abigail; a synowie Sarwii: Abisaj, i Joab, i Asael, trzej.
\v 17 A Abigail urodziła Amazę, a ojciec Amazy był Jeter Ismaelczyk.
\v 18 A Kaleb, syn Hesronowy, spłodził z Azubą, małżonką swoją, i z Jeryjotą synów. A ci byli synowie jego: Jeser, i Sobab, i Ardon.
\v 19 A gdy umarła Azuba, pojął sobie Kaleb Esratę, która mu urodziła Hura.
\v 20 A Hur spłodził Ury, a Ury spłodził Besaleela.
\v 21 Potem wszedł Hesron do córki Machyra, ojca Galaadowego, a pojął ją, będąc w sześćdizesiąt lat; która mu urodziła Seguba.
\v 22 A Segub spłodził Jaira, który miał dwadzieścia trzy miast w ziemi Galaadskiej.
\v 23 Bo wziął Giessurytom, i Assyryjczykom wsi Jairowe, i Kanat z miasteczkami jego, sześćdziesiąt miast. To wszystko pobrali synowie Machyra, ojca Galaadowego.
\v 24 A gdy umarł Hesron w Kaleb Efrata, tedy żona Hesronowa Abija porodziła mu Assura, ojca Tekui.
\v 25 Byli też synowie Jerameelowi, pierworodnego Hesronowego: Pierworodny Ram, po nim Buana, i Oren, i Osem z Abii.
\v 26 Miał także drugą żonę Jerameel, imieniem Atara; ta jest matka Onamowa.
\v 27 Ale synowie Ramowi, pierworodnego Jerameelowego, byli: Maas, i Jamin, i Achar.
\v 28 Byli też synowie Onamowi: Semaj, i Jada, a synowie Semejego: Nadad i Abisur;
\v 29 A imię żony Abisurowej Abihail, która mu urodziła Achobbana i Molida.
\v 30 Synowie Nadabowi: Saled i Affaim; lecz Saled umarł bez potomstwa.
\v 31 A synowie Affaimowi Jesy; a synowie Jesy Sesan, a córka Sesana Achialaj.
\v 32 A synowie Jady, brata Semejego, Jeter i Jonatan; ale Jeter umarł bez potomstwa.
\v 33 A synowie Jonatanowi: Falet i Zyza. Cić byli synowie Jerameelowi.
\v 34 Lecz nie miał Sesan synów, jedno córki; miał też Sesan sługę Egipczanina, imieniem Jeracha.
\v 35 I dał Sesan córkę Jerachowi, słudze swemu, za żonę, która mu urodziła Etaja.
\v 36 Etaj spłodził Natana, a Natan spłodził Zabada.
\v 37 A Zabad spłodził Efijala, a Efijal spłodził Obeda.
\v 38 A obed spłodził Jehu, a Jehu spłodził Azaryjasza.
\v 39 A Azaryjasz spłodził Helesa, a Heles spłodził Elasa.
\v 40 A Elas spłodził Sysmaja, a Sysmaj spłodził Selluma.
\v 41 A Sellum spłodził Ikamijasza, a Ikamijasz spłodził Elisama.
\v 42 A synowie Kaleba, brata Jerameelowego: Mesa pierworodny jego, który był ojcem Zyfejczyków i synów Maresy, ojca Hebrowowego.
\v 43 A synowie Hebronowi: Kore i Tafua, i Rechem, i Semma.
\v 44 A Semma spłodził Rahama, syna Jerkaamowego, a Rechem spłodził Sammajego.
\v 45 A Sammaj był synem Maonowym, a Maon był ojcem Betsurczyków.
\v 46 Efa też, założnica Kalebowa, urodziła Harana, i Moze, i Giezeza; a Haran spłodził Giezeza.
\v 47 A synowie Jachdajowi: Regiem, i Jotam, i Giesan, i Falet, i Efa, i Saaf,
\v 48 Założnica zaś druga Kalebowa Maacha urodziła Sabera, i Tyrchana.
\v 49 A żona Saafowa urodziła ojca Madmeńczyków, i Sewa, ojca Machbeńczyków, i ojca Gabaończyków; a córka Kalebowa była Achsa.
\v 50 Cić byli synowie Kaleba, syna Hurowego, pierworodnego Efraty: Sobal, ojciec Karyjatyjarymczyków.
\v 51 Salma, ojciec Betlehemczyków, Charef, ojciec Betgaderczyków.
\v 52 Miał też synów Sobal, ojciec Karyjatyjarymczyków, który doglądał połowy Menuchoty.
\v 53 A domy Karyjatyjarymskie były Jetrejczycy, i Futejczycy, i Sematejczycy, i Maserejczycy, z których też poszli Saraitowie, o Estaolitowie.
\v 54 A synowie Salmy: Betlehemczycy, i Netofatczycy, ozdoby domu Joabowego, i połowa Manachaty, ojca Sorygo.
\v 55 A domy pisarzów mieszkających w Jabez: Tyryjatejczycy, Symatejczycy, Suchatejczycy. Cić są Cynejczycy, którzy poszli z Hemata, ojca domu Rechabowego.
\c 3
\v 1 Cić są synowie Dawidowi, którzy mu się urodzili w Hebronie: Pierworodny Ammon z Achynoamy Jezreelitki; wtóry Danijel z Abigaili Karmelitki;
\v 2 Trzeci Absalom, syn Maachy, córki Tolmaja, króla Giessur; czwarty Adonijasz, syn Haggity;
\v 3 Piąty Sefatyjasz z Abitaili; szósty Jetraam z Egli, żony jego.
\v 4 Tych sześć urodziło mu się w Hebronie, kędy królował przez siedm lat, i przez sześć miesięcy; a trzydzieści i trzy lata królował w Jeruzalemie.
\v 5 A ci urodzili mu się w Jeruzalemie; Samna, i Sobab, i Natan, i Salomon, cztery synowie z Betsui, córki Ammielowej;
\v 6 I Ibchar, i Elisama, i Elifet;
\v 7 I Noge, i Nefeg, i Jafija;
\v 8 I Elizama, i Elijada, i Elifelet, dziewięć synów.
\v 9 A cić wszyscy są synowie Dawidowi, oprócz synów z założnic; a Tamar była siostra ich.
\v 10 Syn Salomonowy Roboam; Abiam syn jego, Aza syn jego, Jozafat syn jego.
\v 11 Joram syn jego, Ochozyjasz syn jego, Joaz syn jego;
\v 12 Amazyjasz syn jego, Azaryjasz syn jego, Joatam syn jego;
\v 13 Achaz syn jego, Ezechyjasz syn jego, Manases syn jego;
\v 14 Amon syn jego, Jozyjasz syn jego;
\v 15 A synowie Jozyjaszowi: Pierworodny Johanan, wtóry Joakim, trzeci Sedekijasz, czwarty Sellum.
\v 16 A synowie Joakimowi: Jechonijasz syn jego, Sedekijasz syn jego.
\v 17 A synowie Jechonijasza więźnia: Salatyjel syn jego.
\v 18 A salatyjelowi: Malchiram, i Fadajasz, i Seneser, Jekiemija, Hosama, i Nadabija.
\v 19 A synowie Fadajaszowi: Zorobabel, i Semej; a syn Zorobabelowy Mesollam, i Hananijasz, i Selomit, siostra ich.
\v 20 A Mesollamowi: Hasuba, i Ohol, i Barachyjasz, i Hazadyjasz Josabchesed, pięć synów.
\v 21 A syn Hananijaszowy: Faltyjasz, i Jesajasz; synowie Rafajaszowi, synowie Arnanaszowi, synowie Obadyjaszowi, synowie Sechenijaszowi.
\v 22 A synowie Sechenijaszowi: Semejasz; a synowie Semejaszowi: Chattus, i Igal, i Baryja, i Naaryjasz, i Safat; sześć synów.
\v 23 A synowie Naaryjaszowi: Elijenaj, i Ezechyjasz, i Esrykam, trzej synowie.
\v 24 A synowie Elijenajego: Hodawijasz i Elijasub, i Felejasz, i Akkub, i Jochanan, i Dalajasz, i Anani, siedm synów.
\c 4
\v 1 Synowie Judowi: Fares, Hesron, i Charmi, i Hur, i Sobal.
\v 2 A Rejasz, syn Sobalowy spłodził Jahata, a Jahat spłodził Achuma, i Laada. Teć są rodzaje Zaratego.
\v 3 Ci też są z ojca Etama: Jezreel, i Jesema, i Idbas; a imię siostry ich Selelfuni.
\v 4 A Faunuel ojciec Giedory, i Ezer ojciec Hosy. Cić są synowie Hura, pierworodnego Efraty, ojca Betlehemczyków.
\v 5 A Assur, ojciec Tekui, miał dwie żony: Chelę i Naarę.
\v 6 I urodziła mu Naara Achusama, i Hefera, i Temana, i Achastara. Cić są synowie Naary.
\v 7 Synowie zasię Cheli: Seret, Jesochar, i Etnan.
\v 8 A Kos spłodził Anuba, i Hasoboba, i dom Acharchela, syna Harumy.
\v 9 A Jabes był zacniejszy nad braci swych, któremu matka jego dała imię Jabes, mówiąc: Bom go w boleści urodziła.
\v 10 I wzywał Jabes Boga Izraelskiego, mówięc: Jeźli błogosławiąc błogosławić mi będziesz, a rozszerzysz granice moje, a będzie ręka twoja ze mną, a wybawisz mię od złego, abym utrapiony nie był. I wypełnił to Bóg, o co go prosił.
\v 11 A Chelub, brat Sucha, spłodził Mechyra; ten jest ojcem Estona.
\v 12 A Eston spłodził Betrafa, i Paseacha, i Techynna, ojca miasta Nahas. Cić są mężowie Rechy.
\v 13 A synowie Kienazowi: Otonijel, i Seraja; a synowie Otonijelowi: Hatat i Meanataj.
\v 14 A Meanataj spłodził Ofra, a Serajasz spłodził Joaba, ojca w dolinie mieszkających rzemieślników; bo rzemieślnicy byli.
\v 15 Synowie zasię Kaleba, syna Jefumi: Hyru, Ela, i Nahain; a syn Ela jest Kienaz.
\v 16 A synowie Jehaleleela: Zyf i Zyfa, Tyryja, i Azarel.
\v 17 A synowie Ezry: Jeter, i Mered, i Efer, i Jalon; a żona Merodowa urodziła Miryjama, i Samaja, i Isbacha, ojca Estemoa.
\v 18 Żona też jego Judaja urodziła Jereda, ojca Giedor, i Hebera, ojca Socho, i Jekutyjela, ojca Zanoach. Cić są synowie Betii, córki Faraonowej, którą był pojął Mered.
\v 19 A synowie żony Hodyjaszowej, siostry Nahama, ojca Ceili: Garmi i Estemoa Mahatczyk.
\v 20 A synowie Symonowi: Amnon, i Rynna, Benchanan i Tylon; a synowie Isy: Zochet i Bensochet.
\v 21 Synowie Seli, syna Judowego: Her, ojciec Lecha i Laada, ojciec Maraa; i rodzaje domów tych, którzy robili około bisioru w domu Asbeat,
\v 22 I Joakim i mężowie Chozeby, i Joaz i Saraf, którzy panowali w Moab, i Jasubi Lechem; ale te rzeczy są dawne.
\v 23 Cić są garncarze, którzy mieszkali w sadach i między płotami, którzy tam przy królu dla robót jego mieszkali.
\v 24 Synowie Symeonowi: Namuel, i Jamin, i Jaryb, Zera, Saul.
\v 25 Sallum syn jego, Mabsam syn jego, Misma syn jego.
\v 26 A synowie Mismy: Hamuel syn jego, Zachur syn jego, Semej syn jego.
\v 27 Ten Semej miał synów szesnaście, i córek sześć; ale bracia jego nie mieli wiele synów, tak, że wszystkiej rodziny ich nie było tak wiele, jako synów Judowych.
\v 28 I mieszkali w Beerseba i w Molada, i w Hasersual,
\v 29 I w Bela, i w Asem, i w Etolad,
\v 30 I w Betul, i w Horma, i w Sycelegu,
\v 31 I w Bet Marchabot, i w Hasersusa, i w Betbirze, i w Saaraim. Te miasta ich były, póki królował Dawid.
\v 32 A wsi ich były: Etam, i Hain, Remnon, i Tochen i Asan przy tych pięciu miastach;
\v 33 I wszystkie wsi ich, które były około tych miast aż do Baal; teć były mieszkaniem ich według narodu ich.
\v 34 A Mosobab, i Jamlech, i Josa, syn Amazyjaszowy;
\v 35 I Joel, i Jehu, syn Josabijasza, syna Serajaszowego, syna Asyjelowego;
\v 36 I Elichenaj, i Jakóba, i Jesochaja, i Asaja, i Adyjel, i Jesymijel, i Banajas;
\v 37 I Sysa, syn Syfy, syna Allonowego, syna Jodajaszowego, syna Symry, i syna Semajaszowego.
\v 38 Ci mianowani postanowieni są za książęta w narodach swych, a domy ojców ich rozmnożyły się bardzo.
\v 39 Przetoż ruszyli się, aby szli do Gador, aż na wschód słońca onej doliny, aby szukali paszy bydłu swemu.
\v 40 I znaleźli obfite i wyborne pasze, a ziemię przestronną i spokojną i rodzajną; bo tam naród Chamów mieszkał przedtem.
\v 41 Przetoż przyszedłszy ci z imienia opisani za dni Ezechyjasza, króla Judzkiego, poburzyli namioty ich i przybytki ich, które tam były znalezione; a wymordoealiich, i nie masz ich aż do dnia tego, i osiedli miejsce ich; bo tam mieli paszy dla bydeł swoich.
\v 42 A z onych synów Symeonowych niektórzy szli na górę Seir, pięć set mężów, a Faltyjasz, i Necharyjasz, i Rafajasz, i Husel, synowie Isy, byli wodzami ich.
\v 43 I wymordowali ostatki, które były uszły z Amalekitów, a mieszkali tam aż po dziś dzień.
\c 5
\v 1 A synowie Rubena pierworodnego Izraelowego, (ten bowiem był pierworodny; ale gdy zgwałcił łoże ojca swego, dane jest pierworodztwo jego synom Józefa, syna Izraelowego, tak jednak, że go nie poczytano za pierworodnego:
\v 2 Bo Judas był najmężniejsz między braćmi swymi, a książęciem między nimi; ale pierworodztwo należało Józefowi.)
\v 3 Synowie mówię Rubena, pierworodnego Izraelowego, byli: Henoch i Fallu, Hesron i Charmi.
\v 4 Synowie Joelowi: Samajasz syn jego, Gog syn jego, Semej syn jego;
\v 5 Michas syn jego, Reajasz syn jego, Baal syn jego;
\v 6 Bera syn jego, którego wziął w niewolę Teglat Falasar, król Asyryjski; ten był książęciem Rubenitów.
\v 7 A bracia jego według domów swych, gdy byli policzeni według ich narodów, mieli książęta Jehiela i Zacharyjasza.
\v 8 A Bela, syn Azazowy, syna Semmy, syna Joelowego; ten mieszkał w Aroer aż ku Nebo i Baalmeon.
\v 9 Także i na wschód słońca mieszkał, aż kędy wchodzą na puszczę od rzeki Eufrates; albowiem stada ich rozmnożyły się w ziemi Galaadskiej.
\v 10 Ci za dni Saulowych walczyli z Agareńczykami, którzy porażeni są od ręki ich; a tak mieszkali w namiotach ich po wszystkiej krainie wschodniej ziemi Galaadskiej.
\v 11 A synowie Gadowi na przeciwko nich mieszkali w ziemi Bazan, aż do Selchy.
\v 12 Joel był przedniejszym ich, a Safam wtóry, a Janaj i Safat zostali w Bazan.
\v 13 A braci ich według domów ojców swych: Michael i Mesullam, i Seba, i Joraj, i Jachan, i Zyja, i Heber, siedm.
\v 14 (Cić są synowie Abihaila, syna Hurowego, syna Jaroachowego, syna, Galaadowego, syna Michaelowego, syna Jesysowego, syna Jachdowego, syna Buzowego;)
\v 15 Achy, syn Abdyjela, syna Gunowego, książę w domu ojców ich.
\v 16 I mieszkali w Galaad, w Bazan, i w miasteczkach jego, i po wszystkich przedmieściach Saron aż do ich granic.
\v 17 Wszyscy ci policzeni byli za dni Jotama, króla Judzkiego, i za dni Jeroboama, króla Izraelskiego.
\v 18 Synów Rubenowych, i Gadowych, i połowy pokolenia Manasesowego, ludzi walecznych, mężów noszących tarczę i miecz, i ciągnących łuk, i ćwiczonych ku bojowi, czterdzieści i cztery tysiące, siedm set i sześćdziesiąt, wychodzących do bitwy.
\v 19 Ci wiedli wojnę z Agareńczykami, z Jeturejczykami, i z Nafejczykami, i Nodabczykami,
\v 20 A mieli pomoc przeciwko nim. I podani są w rękę ich Agareńczycy ze wszystkim, co mieli, przeto iż do Boga wołali w bitwie, a on ich wysłuchał, iż ufali w nim.
\v 21 I zabrali dobytki ich, wielbłądów ich pięćdziesiąt tysięcy, a owiec dwieście i pięćdziesiąt tysięcy, osłów dwa tysiące, a ludzi sto tysięcy.
\v 22 Albowiem rannych wiele poległo, iż od Boga była ona porażka. I mieszkali na miejscu ich, aż ich zabrano w niewolę.
\v 23 Ale synowie połowy pokolenia Manasesowego mieszkali w onej ziemi od Bazan aż do Baal-Hermon i Sanir, które jest góra Hermon; bo i oni rozmnożeni byli.
\v 24 A cić są książęta domów ojców ich: Efer i Jesy, i Elijel, i Azryjel, i Jeremijasz, i Hodawijasz, i Jachdyjel, mężowie bardzo mocni, mężowie sławni, książęta domu ojców swoich.
\v 25 Ale gdy zgrzeszyli przeciw Bogu ojców swych i cudzołożyli naśladując bogów narodów onej ziemi, które wykorzenił Bóg przed twarzą ich:
\v 26 Wzbudził Bóg Izraelski ducha Fula króla Assyryjskiego, i ducha Teglat Falasera, króla Assyryjskiego, i przeniósł ich: Rubenitów, i Gadydtów, i połowę pokolenia Manasesowego, a zawiódł ich do Hela, i Haboru, i do Ara, i do rzeki Gozan, aż do dnia tego.
\c 6
\v 1 Synowie Lewiego: Gerson, Kaat, i Merary.
\v 2 A synowie Kaatowi: Amram, Izaar, i Hebron, i Husyjel.
\v 3 A synowie Amramowi: Aaron, i Mojżesz, i córka Maryja; a synowie Aaronowi: Nadab, i Abiju, Eleazar, i Itamar.
\v 4 Eleazer spłodził Fineesa; Finees spłodził Abisua.
\v 5 Abissue spłodził Bokki, a Bokki spłodził Uzy.
\v 6 A Uzy spłodził Zerachyjasza, a Zerachyjasz spłodził Merajota.
\v 7 Merajot spłodził Amaryjasza, a Amaryjasz spłodził Achytoba.
\v 8 A Achytob spłodził Sadoka, a Sadok spłodził Achymaasa.
\v 9 Achymaas spłodził Azaryjasza, a Azaryjasz spłodzi× Johanana.
\v 10 A Johanan spłodził Azaryjasz; tenci jest, który kapłański urząd sprawował w domu, który zbudował Salomon w Jeruzalemie.
\v 11 Spłodził też Azaryjasz Amaryjasza, a Amaryjasz spłodził Achytoba.
\v 12 A Achytob spłodził Sadoka, a Sadok spłodził Salluma.
\v 13 A Sallum spłodził Helkijasza, a Helkijasz spłodził Azaryjasza.
\v 14 A Azaryjasz spłodził Sarajasza, a Sarajasz spłodził Jozedeka.
\v 15 Ale Jozedek poszedł w niewolę, gdy Pan przeniósł Judę i Jeruzalem przez Nabuchodonozora.
\v 16 Synowie Lewi: Gierson, Kaat, i Merary.
\v 17 A teć są imiona synów Giersonowych: Lobni i Semei.
\v 18 A synowie Kaatowi: Amram i Izaar, i Hebron, i Husyjel.
\v 19 Synowie Merarego: Macheli, i Muzy. A teć są domy Lewitów według ojców ich.
\v 20 Giersonowi: Lobni syn jego, Jachat syn jego, Zamma syn jego;
\v 21 Joach syn jego, Iddo syn jego, Zara syn jego, Jetraj syn jego.
\v 22 Synowie Kaatowi: Aminadab syn jego, Kore syn jego, Aser syn jego.
\v 23 Elkana syn jego, i Abiazaf syn jego, i Assyr syn jego;
\v 24 Tachat syn jego, Uryjel syn jego, Ozyjasz syn jego, i Saul syn jego.
\v 25 A synowie Elkamowi: Amasaj i Achymot.
\v 26 Elkana. Synowie Elkanowi: Sofaj syn jego, i Nahat syn jego;
\v 27 Elijab syn jego, Jerobam syn jego, Elkana syn jego.
\v 28 A synowie Samuelowi: Pierworodny Wassni i Abijas.
\v 29 Synowie Merarego: Mahali; Lobni syn jego, Symej syn jego, Uza syn jego;
\v 30 Symha syn jego, Haggijasz syn jego, Asajasz syn jego.
\v 31 Ci są, których postanowił do śpiewania w domu Pańskim, gdy tam postawiono skrzynię.
\v 32 I służyli przed przybytkiem namiotu zgromadzenia, śpiewając, aż zbudował Salomon dom Pański w Jeruzalemie, i stali według porządku swego na służbie swojej.
\v 33 A cić są, którzy stali i synowie ich z synów Kaatowych: Heman śpiewak syn Joela, syna Samuelowego,
\v 34 Syna Elkanowego, syna Jerohamowego, syna Elijelowego, syna Tohu,
\v 35 Syna Sufowego, syna Elkanowego, syna Machatowego, syna Amasajowego,
\v 36 Syna Elkanowego, syna Joelowego, syna Azaryjaszowego, syna Sofonijaszowego,
\v 37 Syna Tachatowego, syna Assyrowego, syna Abijasowego,
\v 38 Syna Korego, syna Isarowego, syna Kaatowego, syna Lewiego, syna Izraelowego.
\v 39 A brat jego Asaf, który stawał po prawicy jego. Asaf, syn Barachyjaszowy, syna Samaowego,
\v 40 Syna Michaelowego, syna Basejaszowego, syna Malchyjaszowego,
\v 41 Syna Etny, syna Zerachowego, syna Adajowego,
\v 42 Syna Etanowgo, syna Symmowego,
\v 43 Syna Semejowego, syna Jachatowego, syna Giersonowego, syna Lewiego.
\v 44 A synowie Merarego i bracia ich stawali po lewej stronie: Etan, syn Kuzego, syna Abdego, syna Malluchowego,
\v 45 Syna Hasabijaszowego, syna Amazyjaszowego, syna Helkijaszowego.
\v 46 Syna Amsego, syna Banego, syna Semmerowego,
\v 47 Syna Moholi, syna Musego, syna Merarego, syna Lewiego.
\v 48 A bracia ich Lewitowie postawieni są ku wszelakiej posłudze przybytku domu Bożego.
\v 49 Ale Aaron i synowie jego palili na ołtarzu całopalenia, i na ołtarzu kadzenia przy każdej posłudze świątyni świętych, i ku oczyszczaniu Izraela podług wszystkiego, jako był przykazał Mojżesz, sługa Boży.
\v 50 A ci są synowie Aaronowi: Eleazar syn jego, Finees syn jego,
\v 51 Abisua syn jego, Bokki syn jego, Uzy syn jego, Zerachyjasz syn jego,
\v 52 Merajot syn jego, Amaryjasz syn jego, Achytob syn jego,
\v 53 Sadok syn jego, Achymaas syn jego.
\v 54 A te są mieszkania ich, według pałaców ich w granicy ich, to jest, synów Aaronowych według rodzaju Kaatytów: bo to był ich los.
\v 55 Przetoż dali im Hebron w ziemi Judzkiej, i przedmieścia jego około niego;
\v 56 Ale pole miejskie i wsi ich dali Kalebowi, synowie Jefunowemu.
\v 57 Synom zaś Aaronowym dali z miast Judzkich miasta ucieczki Hebron, i Lobne i przedmieścia jego, i Jeter, i Estemoa, i z przedmieściami jego;
\v 58 I Holon i przedmieścia jego, i Dabir i przedmieścia jego;
\v 59 I Asan i przedmieścia jego, i Betsemes i przedmieścia jego.
\v 60 A z pokolenia Benjaminowego: Gabae i przedmieścia jego, i Almat i przedmieścia jego, i Anatot i przedmieścia jego. Wszystkich miast ich trzynaście miast według domów ich.
\v 61 A synom Kaatowym, pozostałym z rodzaju tegoż pokolenia, dostało się w połowie pokolenia Manasesowego losem miast dziesięć.
\v 62 A synom Giersonowym według domów ich dostało się w pokoleniu Isascharowem, i w pokoleniu Aserowem, i w pokoleniu Neftalimowem, i w pokoleniu Manasesowem w Bazan miast trzynaście.
\v 63 Synom Merarego według domów ich dostało się w pokoleniu Rubenowem, i w pokoleniu Gadowem, i w pokoleniu Zabulonowem losem miast dwanaście.
\v 64 Dali też synowie Izraelscy Lewitom miasta i przedmieścia ich;
\v 65 A dali je losem w pokoleniu synów Judowych, i w pokoleniu synów Symeonowych, i w pokoleniu synów Benjaminowych, miasta te, które nazwali imiony swemi.
\v 66 A tym, którzy byli z rodu synów Kaatowych, (a były miasta i granice ich w pokoleniu Efraim.)
\v 67 Tym dali z miast ucieczki Sychem i przedmieścia jego na górze Efraim, i Gazer i przedmieścia jego.
\v 68 I Jekmaan i przedmieścia jego, i Betoron i przedmieścia jego;
\v 69 I Ajalon i przedmieścia jego, i Gatrymon i przedmieścia jego.
\v 70 A w połowie pokolenia Manasesowego: Aner i przedmieścia jego, Balam i przedmieścia jego. To dali rodzajowi pozostałemu synów Kaatowych.
\v 71 Synom też Giersonowym z rodu połowy pokolenia Manasesowego dali Golan w Bazan i przedmieścia jego, i Astarot i przedmieścia jego;
\v 72 A w pokoleniu Isascharowem Kades i przedmieścia jego, Daberet i przedmieścia jego.
\v 73 I Ramot i przedmieścia jego, i Anam i przedmieścia jego.
\v 74 A w pokoleniu Aserowem Masal i przedmieścia jego, i Abdon i przedmieścia jego,
\v 75 I Hukok i przedmiescia jego, i Rohob i przedmieścia jego.
\v 76 A w pokoleniu Neftalimowem: Kades w Galilei, i przedmieścia jego, i Hammon i przedmieścia jego, i Kiryjataim i przedmieścia jego.
\v 77 Synom Merarego, pozostałym z pokolenia Zabulon, dane są Remmon i przedmieścia jego, Tabor i przedmieścia jego.
\v 78 A za Jordanem u Jerycha na wschód słońca od Jordanu, dane są w pokoleniu Rubenowem: Besor na puszczy, i przedmieścia jego, i Jahasa i przedmieścia jego.
\v 79 I Kiedemot i przedmieścia jego, i Mefaat i przedmieścia jego.
\v 80 A w pokoleniu Gadowem Ramot w Galaad i przedmieścia jego; i Mahanaim i przedmieścia jego.
\v 81 Hesebon i przedmieścia jego, i Jazer i przedmieścia jego.
\c 7
\v 1 A synowie Isascharowi: Tola i Fua, Jasub, i Semram, czterej.
\v 2 A synowie Tolego: Uzy, i Rafajasz, i Jeryjel, i Jachamaj, i Jebsam, i Samuel; a cić byli książętami według domów ojców swych, którzy poszli z Tole, mężowie bardzo duży według narodów swych; poczet ich był za dni Dawodowych dwadzieścia i dwa tysiące i sześć set.
\v 3 A synowie Uzego: Izrahyjasz; a synowie Izrahyjaszowi: Michael i Obadyjasz, i Joel, Jesyjasz; pięć książąt wszystkich.
\v 4 A z nimi w narodach ich, według domów ojców ich, poczet mężów walecznych trzydzieści i sześć tysięcy; bo mieli wiele żon i synów.
\v 5 A braci ich według wszystkich rodzajów Isascharowych, mężów dużych było ośmdziesiąt i siedm tysięcy, wszystkich policzonych.
\v 6 Synowie Benjaminowi: Bela i Bechor, i Jedyjael, trzej.
\v 7 Synowie zaś Belego: Esbon i Uzy, i Uzyjel, i Jerymot, i Iry; pięć książąt domów ojcowskich, mężów dużych; naliczono dwadzieścia i dwa tysiące, i trzydzieści i cztery.
\v 8 A synowie Bechorowi; Zamirai i Joaz, i Eliezer, i Elienaj, i Amry, i Jerymot, i Abijasz, i Anatot, i Alamat; wszyscy ci synowie Bechorowi.
\v 9 A naliczono ich według rodzajów ich, książąt domów ojców ich, mężów udatnych dwadzieścia tysięcy i dwieście.
\v 10 A synowie Jedyjaelowi: Bilan; a synowie Bilanowi: Jehus, i Banjamin, i Ehod, i Chanaan, i Zetan, i Tarsys, i Achysachar.
\v 11 Tych wszystkich synów Jadyjaelowych według książąt domów ojcowskich, mężów bardzo dużych siedmnaście tysięcy i dwieście, wychodzących na wojnę do bitwy;
\v 12 Oprócz Suppim i Ofim, synów w domu zrodzonych, i Husym, i synów w obcym kraju zrodzonych.
\v 13 A synowie Neftalimowi: Jachsel, i Guni, i Jesser, i Selem, synowie Bali.
\v 14 A synowie Manasesowi: Asryjel, którego mu urodziła Zona, (a założnica jego Syryjanka urodziła Machyra, ojca Galaadowego.
\v 15 A Machyr wziął sobie za żonę siostrę Ofimową i Suppimową, której imię było Maacha;) a imię drugiego Salfaad, i miał Salfaad córki.
\v 16 A urodziła Maacha, żona Machyrowa, syna, i nazwała imię jego Fares; a imię brata jego Sares, a synowie jego Ulam i Rekiem.
\v 17 A synowie Ulamowi Bedon. Cić są synowie Galaada, syna Machyrowego, syna Manasesowego.
\v 18 A siostra jego Molechet urodzi×a Isoda, i Abiezera, i Machala.
\v 19 A synowie Semidowi byli Ahyjan, i Sechem, i Likchy, i Anijam.
\v 20 A synowie Efraimowi: Sutala, i Bered syn jego, i Tachat syn jego, i Elada syn jego, i Tachat syn jego;
\v 21 I Zabad syn jego, i Sutala syn jego, i Eser, i Elad. A pobili ich mężowie z Get, co się byli zrodzili w onej ziemi; albowiem byli wtargnęli, aby pobrali dobytki ich.
\v 22 Przetoż płakał Efraim, ojciec ich, przez wiele dni; i przyszli bracia jego, aby go cieszyli.
\v 23 Córkę też jego Seerę, która pobudowała Betoron niższe i wyższe, i Uzenzeera;
\v 24 I Refacha syna jego, i Resefa, i Telacha syna jego, i Techena syna jego;
\v 25 I Laadana syna jego, Ammiuda syna jego, Elisama syna jego;
\v 26 Nuna syna jego, Jozuego syna jego.
\v 27 A osiadłość ich i mieszkania ich, Betel i wsi jego; a na wschód słońca Naaran; a na zachód słońca Gazer i wsi jego, i Sychem i wsi jego, aż do Aza i wsi jego.
\v 28 A podle miejsc synów Manasesowych: Betsan, i wsi jego, Tanach i wsi jego, Magieddon i wsi jego, Dor i wsi jego. W tych mieszkali synowie Józefowi, syna Izraelowego.
\v 29 Synowie Aserowi: Jemna i Jesua, Iswy i Beryja, i Sera, siostra ich.
\v 30 A synowie Beryjaszowi: Heber i Melchyjel; ten jest ojciec Birsawitów,
\v 31 A Heber spłodził Jafleta, i Somera, i Hotama, i Suę, siostrę ich.
\v 32 A synowie Jafletowi: Pasach i Bimhal i Aswat. Cić są synowie Jafletowi.
\v 33 A synowie Somerowi: Ahy i Rohaga, Jechuba i Aram.
\v 34 A synowie Helema, brata jego: Sofach, Jemna, i Seles, i Amal.
\v 35 Synowie Sofachowi: Suach, Harnefer, i Sual, i Bery, i Imra.
\v 36 Beser, i Hod, i Sema, i Silsa, i Jetram, i Bera.
\v 37 A synowie Jeterowi: Jefone, i Fispa, i Ara, i Ulla.
\v 38 A synowie Ullowi: Arach, i Haniel, i Rysyjasz.
\v 39 Ci wszyscy są synowie Aserowi, książęta domów rodzajów swych, wybrani i duży mężowie, przedniejsi z książąt, którzy policzeni są na wojnę do bitwy; poczet tych mężów dwadzieścia i sześć tysięcy.
\v 40
\c 8
\v 1 A Benjamin spłodził Belę, pierworodnego swego, Asbela wtórego, i Abracha trzeciego.
\v 2 Nocha czwartego, a Rafajasza piątego.
\v 3 A synowie Beli byli Addar i Giera i Abihud.
\v 4 I Abisua i Noaman i Achoach.
\v 5 I Giera i Sufam i Churam.
\v 6 A cić są synowie Echudowi: ci są książętami narodów mieszkających w Gabaa, którzy je przenieśli do Manakat;
\v 7 To jest Noaman, i Achija, i Giera; on je przeniósł, a spłodził Uzę, i Ahyhuda, i Sacharaima.
\v 8 A Sacharaim spłodził dzieci w krainie Moabskiej, gdy one był odprawił, z Chusymą, i Barą, żonami swemi.
\v 9 Spłodził tedy z Hodes, żoną swą, Jobaba, i Sebijasza, i Mezę, i Malchama.
\v 10 I Jehusa, i Sachyjasza, i Mirmę. Cić są synowiejego, książęta domów ojcowskich.
\v 11 A z Chysymą spłodził Abituba i Elfaala.
\v 12 A synowie Elfaalowi: Eber, i Misaam, i Samed, który zbudował Ono, i Lod i wsi jego.
\v 13 A Beryja i Sama byli książętami narodíw mieszkających w Ajalon; ci wygnali obywateli z Get.
\v 14 A Achyjo, Sesak i Jerymot,
\v 15 I Zabadyjasz, i Arad, i Hader,
\v 16 I MIchael, i Isfa, i Jocha, synowie Berajaszowi.
\v 17 A Zabadyjasz, i Mesullam, i Hyszki, i Heber,
\v 18 I Ismaraj, i Islijasz, i Jobab, synowie Elfaalowi.
\v 19 A Jakim, i Zychry, i Zabdy,
\v 20 I Elienaj, i Selataj, i Eliel,
\v 21 I Adajasz, i Berajasz, i Symrat, synowie Synchy.
\v 22 A Isfan, i Eber, i Eliel,
\v 23 I Abdon, i Zychry, i Chanan,
\v 24 I Hananijasz, i Eleam, i Anatotyjasz,
\v 25 I Ifdajasz, i Fanuel, synowie Sesakowi.
\v 26 I Samseraj, i Zecharyjasz, i Atalijasz,
\v 27 I Jaresyjasz, i Elijasz, i Zychry, synowie Jerochamowi.
\v 28 Ci są książęta domów ojcowskich według rodzajów swych, a ci książęta mieszkali w Jeruzalemie.
\v 29 A w Gabaonie mieszkał ojciec Gabaończyków, a imię żony jego było Maacha.
\v 30 A syn jego pierworodny Abdon; po nim Sur, i Cys, i Baal, i Nadab.
\v 31 I Giedor, i Achyjo, i Zechar.
\v 32 Ale Michlot spłodził Symejasza; a ci także naprzeciwko braci swych mieszkali w Jeruzalemie z braćmi swymi.
\v 33 A Ner spłodził Cysa, a Cys spłodził Saula; Saul zaś spłodził Jonatana i Melchisuego, i Abinadaba i Esbaala.
\v 34 A syn Jonatanowy był Merybbaal, a Merybbaal spłodził Michasa.
\v 35 A synowie Michasowi: Fiton i Melech i Tarea i Achaz.
\v 36 A Achaz spłodził Joada, a Joada spłodził Alemeta i Asmaweta i Zymrego, a Zymry spłodził Mose;
\v 37 A Mosa spłodził Binę; Refajasz syn jego, Elasa syn jego, Asel syn jego.
\v 38 Ten Asel miał sześć synów, a teć imiona ich: Asrykam, Bochru, i Ismael, i Searyjasz, i Obadyjasz, i Hanan; ci wszyscy synowie Aselowi.
\v 39 A syowie Eseka, brata jego: Ulam pierworodny jego. Jehus wtóry, i Elifelet trzeci.
\v 40 A synowie Ulamowi byli mężowie duży, i mocno łuk ciągnący, którzy mieli wiele synów i wnuków, aż do stu i pięćdziesiąt. Ci wszyscy poszli z synów Benjaminowych.
\c 9
\v 1 A tak wszyscy Izraelczycy obliczeni są; a oto zapisani są w księgach królów Izraelskich i Judzkich, a przeniesieni są do Babilonu dla przestępstwa swego.
\v 2 Lecz którzy pierwsi mieszkali w osiadłościach swych i w miastach swoich, Izraelczycy, kapłani, Lewitowie, i Netynejczycy.
\v 3 W Jeruzalemie mieszkali z synów Judowych, i z synów Benjaminowych, i z synów Efraimowych, i Manasesowych;
\v 4 Uttaj, syn Ammiuda, syna Amry, syna Imry, syna Bonny, z synów Faresa, syna Judowego.
\v 5 A z Sylona: Asajasz pierworodny, i synowie jego.
\v 6 A z synów Zerachowych: Jehuel i braci ich sześć set i dziewięćdziesiąt.
\v 7 A z synów Benjaminowych: Salu, syn Mesullama, syna Hodowiego, syna Asenuowego.
\v 8 A Ibnijasz, syn Jerochamowy, i Ela, syn Uzego, syna Michry, i Mesullam, syn Sefatyjasza, syna Rehuelowego, syna Ibnijaszowego.
\v 9 Także braci ich według narodów ich było dziewięć set i pięćdziesiąt i sześć: ci wszyscy mężowie byli książętami rodzajów według domów ojców swoich.
\v 10 Z kapłanów zasię: Jedejasz, i Jechojaryk, i Jachyn,
\v 11 I Azaryjasz, syn Helkijasza, syna Mesullamowego, syna Sadokowego, syna Merajatowego, syna Achytobowego, był książęciam domu Bożego.
\v 12 I Adajasz, syn Jerohama, syna Fassurowego, syna Melchyjaszowego, i Maasaj, syn Adyjela, syna Jechserowego, syna Mesulla,owego, syna Mesullemitowego, syna Immerowego.
\v 13 A braci ich książęt według domów ojców ich było tysiąc i siedm set i sześćdziesiąt, mążów dużych ku sprawowaniu posługi w domu Bożym.
\v 14 A z Lewitów: Semejasz, syn Hassuba, syna Asrykamowego, syna Hasabijaszowego, z synów Merarego;
\v 15 I Bakkabar, Cheres, i Galal, i Matanijasz, syn Michy, syna Zychrego, syna Asafowego;
\v 16 Obadyjasz też, syn Semahajasza, syna Galalowego, syna Jedytunowego, i Barachyjasz, syn Asy, syna Elkanowego, który mieszkał we wsiach Netofatyckich.
\v 17 A odźwierni: Sallum, i Akkub, i Talmon, i Ahyman, i nracia ich; Sallum książę między nimi.
\v 18 Który aż dotąd w bramie królewskiej stawał na wschód słońca; ci byli odźwiernymi według pocztów synów Lewiego.
\v 19 Ale Sallum, syn Korego, syna Abijazafowego, syna Korego, i bracia jego z domu ojca jego, Korytczycy byli ku odprawowaniu posługi, stróżami progów namiotu; a ojcowie ich byli nad obozem Pańskim stróżami wejścia.
\v 20 A Finees syn Eleazarowy, był książęciem nad nimi, a Pan był z nimi.
\v 21 Zacharyjasz zasię, syn Mesellemijaszowy, był odźwiernym drzwi u namiotu zgromadzenia.
\v 22 Cić wszyscy są obrani za odźwiernych do drzwi, dwieście osób i dwanaście: ci we wsiach swych policzeni są, których postanowił Dawid i Samuel widzący, dla wierności ich,
\v 23 Aby oni i synowie ich byli we drzwiach domu Pańskiego, w domu namiotu na straży.
\v 24 I byli odźwierni po czterech stronach, na wschód, na zachód, na północy, i na południe.
\v 25 Bracia zasię ich byli we wsiach swych, przychodząc każdego siódmego dnia, od czasu aż do czasu odmieniając się z nimi.
\v 26 Albowiem pod sprawą tych czterech przedniejszych odźwiernych byli Lewitowie, a byli przełożeni nad gmachami i nad skarbami domu Bożego;
\v 27 A około domu Bożego nocowali, gdyż im należała straż jego; a oni go na każdy poranek otwierali.
\v 28 A z nich niektórzy byli nad naczyniem ku posługiwaniu; albowiem pod liczbą wnosili je, i pod liczbą wynosili je.
\v 29 Niektózry zasię z nich byli postanowieni nad innem naczyniem, i nad wszystkiem naczyniem świątnicy, i nad mąką pszenną i winem, i oliwą, i kadzidłem, i nad rzeczami wonnemi.
\v 30 A niektórzy z synów kapłańskich sprawowali maści z rzeczy wonnych.
\v 31 Matatyjasz też z Lewitów, pierworodny Salluma Korytczyka, był przełożony nad rzeczami, które w panwiach smażono.
\v 32 A z synów Kaatowych z braci ich, byli niektórzy przełożonymi nad chlebami pokładnemi, aby je gotowali na każdy sabat.
\v 33 A z tych byli śpiewacy, przedniejsi z domów ojcowskich, między Lewitami mieszkający w gmachach, od inszych prac wolni; bo we dnie i w nocy powinności swej pilnować musieli.
\v 34 Ci przedniejsi z domów ojcowskich między Lewitami, według narodów swych przedniejsi; ci mieszkali w Jeruzalemie.
\v 35 A w Gabaonie mieszkali ojciec Gabaończyków Jehyjel, a imię żony jego Maacha;
\v 36 A syn jego pierworodny Abdon, po nim Sur, i Cys, i Baal, i Neer, i Nadab,
\v 37 I Giedeor, i Achyjo, i Zacharyjasz, i Michlot;
\v 38 (A Michlot spłodził Symmama) a ci także przweciw braci swych mieszkali w Jeruzalemie z braćmi swymi.
\v 39 A Neer spłodził Cysa, a Cys spłodził Saula, a Saul spłodził Jonatana, i Melchisuego, i Abidanaba, i Esbaala.
\v 40 A syn Jonatana Merybbaal; a Merybbaal spłodził Michasa.
\v 41 Synowie zaś Michasowi: Fiton, i Melech, i Tarea, i Achaz.
\v 42 A Achaz spłodził Jarę; a Jara spłodził Alemeta, i Asmaweta, i Zynrego; a Zymry spłodził Mosę.
\v 43 A Mosa spłodził Binę; a Refajasz syn jego, Elasa syn jego, Asel syn jego.
\v 44 A Asel miał sześć synów; a teć imiona ich: Asrykam, i Bochru, i Ismael, i Searyjasz, i Obadyjasz, i Hanan. Cić są synowie Aselowi.
\c 10
\v 1 A gdy Filistynowie walczyli z Izraelem, uciekli mężowie Izraelscy przed Filistynami a polegli, będąc porażeni na górze Gielboe.
\v 2 I gonili Filistynowie Saula i synów jego; i zabili Filistynowie Jonatana, i Abinadaba, i Melchisuego, synów Saulowych.
\v 3 A gdy się zmocniła bitwa przeciw Saulowi, trafili na niego strzelcy, i z łuku zraniony jest od strzelców.
\v 4 Rzekł tedy Saul do sługi swego, co za nim broń nosił: Dobądź miecza twego, a przebij mię nim, by snać nie przyszli ci nieobrzezańcy, a nie pośmiewali się ze mnie. Ale nie chciał sługa, który nosił broń jego; bo się bardzo bał. Przetoż porwawszy Saul miech, padł nań.
\v 5 A widząc sługa, co nosił broń jego, że umarł Saul, padłszy też i sam na miecz umarł.
\v 6 A tak umarł Saul, i trzej synowie jego, i wszystek dom jego z nim pospołu zginął.
\v 7 Co gdy ujrzeli wszyscy mężowie Izraelscy, którzy mieszkali na dolinie, iż uciekli Izraelczycy, a iż pomarli Saul i synowie jego, opuściwszy miasta swe także uciekli. I przyszli Filistynowie, i mieszkali w nich.
\v 8 A gdy nazajutrz przyszli Filistynowie brać łupy z pobitych, znaleźli Saula, i synów jego, leżących na górze Gielboe;
\v 9 A złupiwszy go wzięli głowę jego, i zbroję jego, i posłali po ziemi Filistyńskiej w około, aby to ogłoszone było przed bałwany ich, i przed ludem.
\v 10 I położyli zbroję jego w domu boga swego, a głowę jego zawiesili w domu Dagonowym.
\v 11 Usłyszawszy tedy wszyscy mężowie Jabes Galaad wszystko, co uczynili Filistynowie Saulowi,
\v 12 Powstali wszyscy mężowie mocni, i wzięli ciało Saulowe, i ciało synów jego, a przyniósłszy do Jabes pogrzebli kości ich pod dębem w Jabes, i pościli przez siedm dni.
\v 13 A tak umarł Saul dla przestępstwa swego, którem był wystąpił przeciwko Panu, i przeciwko słowu Pańskiemu, któego nie przestrzegał, iż się radził ducha wieszczego, pytając się go;
\v 14 A iż się nie radził Pana, zabił go, a przeniósł królestwo na Dawida, syna Isajego.
\c 11
\v 1 Zebrał się tedy wszystek Izrael do Dawida do Hebronu, mówiąc: Otośmy kość twoja i ciało twoje!
\v 2 Jako i przedtem, gdy jeszcze był Saul królem, też wywodził i wwodził Izraela. Tak Pan, Bóg twój, rzekł tobie: Ty będziesz pasł lud mój Izraelski, a ty będziesz wodzem nad ludem moim Izraelskim.
\v 3 A tak przyszli wszyscy starsi Izraelscy do króla do Hebronu, i uczynił Dawid z nimi przymierze w Hebronie przed Panem, i pomazali Dawida za króla nad Izraelem według słowa Pańskiego, które powiedział przez Samuela.
\v 4 Jechał tedy Dawid ze wszystkim Izraelem do Jeruzalemu, które jest Jebus, gdzie byli Jebuzejczycy obywatelami ziemi.
\v 5 I rzekli obywatele Jebuzejscy do Dawida: Nie wnijdziesz sam. Ale Dawid wziął zamek Syoński, który jest miastem Dawidowem.
\v 6 Bo był rzekł Dawid: Ktobykolwiek poraził Jebuzejczzyka najpierwej, ten będzie skiążęciem i hetmanem. Przetoż wstąpił najpierw Joab, syn Sarwii, i został hetmanem.
\v 7 I mieszkał Dawid na onym zamku; dla tego nazwano go miastem Dawidowem.
\v 8 I zbudował miasto w około, od Mello aż w okrąg; a Joab pobudował ostatek miasta.
\v 9 A tak Dawid im dalej, tem więcej rozmnażał się, i rosł; albowiem Pan zastępów był z nim.
\v 10 A cić są najorzedniejsi rycerze, których miał Dawid, którzy się mężnie starali z nim o królestwo jego ze wszystkim Izraelem, aby go królem uczynili według słowa Pańskiego nad Izraelem.
\v 11 A tenci jest poczet rycerzy, których miał Dawid: Jasobam, syn Chachmonowy, przedniejszy między trzydziestoma; ten podniósłszy oszczep swój na trzystu, jednym razem ich zabił.
\v 12 A po nim Elezar, syn Dodonowy, Achochytczyk; ten był jednym między trzema mocarzami.
\v 13 Ten był z Dawidem w Pasdamim, gdzie się zebrali byli Filistynowie ku bitwie; a była ona część pola pełna jęczmienia, a lud był uciekł przed Filistynami.
\v 14 I stanęli w pośród onego pola, i obronili go, a porazili Filistynów: i wybawił Pan lud wybawieniem wielkiem.
\v 15 Ci także trzej ze trzydziestu przedniejszych wstąpili na skałę do Dawida do jaskini Odollam, gdyż wojsko Filistyńskie leżało obozem w dolinie Rafaim;
\v 16 Albowiem Dawid natenczas mieszkał na zamku, a stanowisko Filistyńskie było natenczas w Betlehem.
\v 17 Pragnęł tedy Dawid: Oby mi się kto dał napić wody z studni Betlehemskiej, która jest u bramy!
\v 18 Przetoż przebiwszy się ci trzej przez wojsko Filistyńskie, naczerpali wody z studni Betlehemskiej, która jest u bramy, a wziąwszy przynieśli do Dawida. Lecz jej nie chciał Dawid pić, ale ją wylał na ofiarę Panu.
\v 19 I rzekł: Nie daj mi tego, Boże mój, abym to uczynić miał! Izali krew tych mężów pić będą, którzy odważyli żywot swój? albowiem z odwagą żywota swego przynieśli ją; i nie chciał jej pić. Toć uczynili trzej oni mocarze.
\v 20 A Abisaj, brat Joabowy, był przedniejszy z onych trzech; tenże podniósł włócznię swą na trzysta ludu, które pobił, i otrzymał sławę między onymi trzema.
\v 21 Z tych trzech nad innych dwóch był sławniejszy, a był ich książęciem; jednak onych trzech pierwszych nie doszedł.
\v 22 Banajas też, syn Jojady, syn męża dużego, wielkich spraw, z Kabseela, ten zabił dwóch mocarzów Moabskich; ten też zszedłszy zabił lwa w pośród jamy, gdy był śnieg.
\v 23 Ten też zabił męża Egipczanina, męża, którego wzrost był na pięć łokci. A chociaż Egipczanin miał w ręku oszczep jako nawój tkacki, wszkże przyszedł do niego z kijem, i wydarł oszczep z ręki Egipczanina, i zabił go oszczepem jego.
\v 24 To uczynił Banajas, syn Jojady, który także sławnym został między onymi trzema mocarzami.
\v 25 A choć był między onymi trzydziestoma sławnym, wszakże nie doszedł onych trzech. I postanowił go Dawid nad drabantami swymi.
\v 26 A w wojsku co mocniejsi byli: Asael, brat Joabowy, Elkanan, syn Dodonowy z Betlehem;
\v 27 Sammot Harodczyk, Heles Felonitczyk;
\v 28 Hyra, syn Ikkiesowy, Tekuitczyk, Abiezer Anatotczyk;
\v 29 Sybbechaj Husatczyk, Ilaj Ahohytczyk;
\v 30 Maharaj Netofatczyk, Heled, syn Baamy, Netofatczyk;
\v 31 Itaj, syna Rybajego, z Gabaat synów Benjaminowych, Banajas Faratończyk;
\v 32 Hutaj od potoku Gaas; Abiel Arbatczyk;
\v 33 Asmawet Bacharomczyk; Elijachba Salabończyk.
\v 34 Synowie Asema Gisończyka: Jonatan, syn Sagii, Hororczyk;
\v 35 Ahijam, syn Zacharowy, Ararytczyk, Elifal, syn Urowy;
\v 36 Hefer Mecheratczyk, Achijas Felonitczyk;
\v 37 Hesro Karmelczyk, Naaraj, syn Ezbajowy;
\v 38 Joel, brat Natanowy,Michbar, syn Gierego.
\v 39 Selek Ammonitczyk, Nacharaj Berotczyk, który nosił broń Koaba, syna Sarwii;
\v 40 Hyra Itrejczyk, Gareb Itrejczyk;
\v 41 Uryjasz Hetejczyk, Zabad, syn Achalajego.
\v 42 Adyna, syn Sysy, Rubenitczyk, książę Rubenitów, a z nim trzydzieści mężów.
\v 43 Hanan, syn Maachy, i Jozafat Mitnitczyk.
\v 44 Uzyjasz Asteratczyk, Sama i Jehijel, synowie Hotamy Aroerytczyka.
\v 45 Jedinael, syn Symry, i Jocha, brat jego, Tysytczyk.
\v 46 Eliel Machawimczyk, i Jerybaj, i Josawijasz, synowie Elnaamowi, i Itma Moabczyk.
\v 47 Eliel, i Obed, i Jaasyjel z Mezobaj.
\c 12
\v 1 A cić są, co byli przyszli do Dawida do Sycelegu, gdy się jeszcze krył przed Saulem, synem Cysowym; a ci byli między mocarzami posiłek dawający w bitwie,
\v 2 Noszący łuk, a prawą i lewą ręką ciskający kamieńmi, i strzelający z łuku, a byli z braci Saulowych z pokolenia Benjaminowego:
\v 3 Książe Achyjezer, i Joaz, synowie Semmai Gabatczyka, i Jezyjel, i Falet, synowie Azmawetowi, i Baracha, i Jehu Anatotczyk;
\v 4 Ismajasz też Gabaończyk, mężny między trzydziestoma, a był przełożony nad trzydziestoma; i Jeremijasz, i Jahazyjel, Johanan, i Jozabad Gliederatczyk;
\v 5 Eluzaj, i Jerymot, i Bealijasz, i Semaryjasz, i Sefatyjasz Harufitszyk;
\v 6 Elkana, i Jesyjasz, i Asareel i Joezer, i Jasobam Korchytczyk;
\v 7 I Joela, i Zebadyjasz, synowie Jerohamowi z Giedor.
\v 8 A z pokolenia Gadowego zbiegli byli do Dawida na miejsce obronne na puszczę mężowie duży, mężowie sposobni do boju, noszący tarcz i kopiję, których twarze były jako lwie tarze, a jako sarny po górach prędcy;
\v 9 Eser przedniejszy, Obadyjasz wtóry, Elijab trzeci,
\v 10 Mismanna czwarty, Jeremijasz piąty,
\v 11 Ataj szósty, Eliel siódmy,
\v 12 Jochanan ósmy, Elzebad dziewiąty,
\v 13 Jeremijasz dziesiąty, Machbanajasz jedenasty.
\v 14 Cić byli z synów Gadowych, hetmani wojska, jeden nad stem mniejszy, a większy nad tysiącem.
\v 15 Cić są, którzy przeszli Jordan miesiąca pierwszego, który był wylał ze wszystkich brzegów swoich; i wygnali wszystkich mieszkających w dolinach na wschód i na zachód słońca.
\v 16 Przyszli także niektórzy z synów Benjaminowych i z Judowych, do miejsca obronnego, do Dawida.
\v 17 I wyszedł Dawid przeciwko nim a odpowiadając, rzekł im: Jeźliście spokojnie przyszli do mnie, abyście mię ratowali, serce też moje złączy się z wami; ale jeźliście przyszli, abyście mię wydali nieprzyjaciołom moim, (choć nie masz nieprawości przy mnie) niech w to wejrzy Bóg ojców naszych, a niech sądzi.
\v 18 Tedy Duch przyoblekł Amazyjasza, przedniejszego między hetmanami, i rzekł: Twoiśmy, o Dawidzie! a z tobą przestajemy, synu Isajego. Pokój, pokój tobie, i pokój pomocnikom twoim! gdyż ci pomaga Bóg twój. A tak przyjął ich Dawid, i postanowił ich hetmanami wojska.
\v 19 A z pokolenia Manasesowego odpadli niektórzy do Dawida, gdy ciągnął z Filistynami przeciwko Saulowi na wojnę; ale im nie byli na pomocy, gdyż naradziwszy się książęta Filistyńscy odesłali go, mówiąc: Ten z niebezpieczeństwem głów naszych odpadnie do Saula, pana swego.
\v 20 Gdy tedy szedł do Syceleu, uciekli do niego niektórzy z pokolenia Manasesowego: Adnach i Josabad, i Jediael, i Michael, i Jozabad i Elihu, i Sylletaj, i hetmani nad tysiącami w pokoleniu Manasesowem.
\v 21 A ci posiłkowali Dawida przeciw onemu hufowi; bo mężni byli wszyscy, przetoż byli hetmanami w wojsku jego.
\v 22 Nawet na każdy dzień ściągali się do Dawida na pomoc jemu, aż było wojsko wielkie jako wojsko Boże.
\v 23 A tać jest liczba przedniejszych gotowych do boju, którzy przyszli do Dawida do Hebronu, aby przenieśli królestwo Saulowe do niego według słowa Pańskiego.
\v 24 Z synów Judowych, noszących tarcz i włócznię, sześć tysięcy i ośm set gotowych do boju.
\v 25 Z synów Symeonowych, mężnych do boju, siedm tysięcy i sto.
\v 26 Z synów Lewiego cztery tysiące i sześć set.
\v 27 Jojada także przedniejszy z synów Aaronowych, a z nim trzy tysiące i siedm set.
\v 28 A Sadok młodzieniec, rycerz mężny, i z domu ojca jego książąt dwadzieścia i dwóch.
\v 29 A z synów Benjaminowych, braci Saulowych, trzy tysiące; bo jeszcze wielka część ich przestawała z domem Saulowym.
\v 30 A z synów Efraimowych dwadzieścia tysięcy i ośm set, ludzi mężnych, mężów sławnych w domach ojców ich.
\v 31 A z połowy pokolenia Manasesowego ośmnaście tysięcy, którzy byli mianowani według imion, aby przyszli i postanowili Dawida królem.
\v 32 A z synów Isascharowych, umiejących rozeznawać czasy, tak iż wiedzieli, co kiedy czynić miał Izrael, książąt ich dwieście; a wszyscy bracia ich przestawali na radzie ich.
\v 33 Z pokolenia Zabulonowego, którzy wychodzili na wojnę, gotowych do boju z każdym orężem wojennym, pięćdziesiąt tysięcy, stawających w szyku jednostajnem sercem.
\v 34 A z pokolenia Neftalimowego książąt tysiąc, a z nimi z tarczami i z kopijami trzydzieści i siedm tysięcy.
\v 35 A z pokolenia Danowego, gotowych do boju, dwadzieścia i ośm tysięcy i sześć set.
\v 36 A z pokolenia Aserowego, którzy wychodzili na wojnę, i umieli się szykować do bitwy, czterdzieści tysięcy.
\v 37 A z Za-Jordania z pokolenia Rubenowego i Gadowego, i z połowy pokolenia Manasesowego ze wszystkim orężemwojennym sto i dwadzieścia tysięcy.
\v 38 Ci wszyscy mężowie waleczni sprawni ku bitwie, sercem uprzejmem przyszl do Hebronu, aby postanowili Dawida królem nad wszystkim Izraelem. Nadto i wszyscy inni z Izraela jednego serca byli, aby postanowili królem Dawida.
\v 39 I byli tam z Dawidem przez trzy dni jedząc i pijąc: bo im byli nagotowali bracia ich.
\v 40 Także i którzy blisko ich byli aż do Isaschar i Zabulon i Neftalim, przynosili chleby na osłach, i na wielbłądach, i na mułach, i na wołach, potrawy, mąki, figi, rodzynki, i wino, i oliwę, i wołów, i owiec wielkim dostatkiem; bo była radość w Izraelu.
\c 13
\v 1 A Dawid wszedł w radę z hetmanami nad tysiącami, i z setnikami, i ze wszystkimi rotmistrzami.
\v 2 I mówił Dawid do wszystkiego zgromadzenia Izraelkskiego: Jeźli się wam podoba, i jeźli to jest od Pana Boga naszego, roześlijmy wszędy do braci naszych pozostałych po wszystkich krainach Izraelskich; przytem też do kapłanów i Lewitów po miastach i przedmieściach ich, a niech się zgromadzą do nas:
\v 3 Abyśmy przeprowadzili skrzynię Boga naszego do nas; albowiem nie pytaliśmy się o niej za dni Saulowych.
\v 4 I rzekło wszystko zgromadzenie, aby się tak stało; bo się ta rzecz podobała wszystkiemu ludowi.
\v 5 Zebrał tedy Dawid wszystkiego Izraela od Nilu Egipskiego aż gdzie się chodzi do Emat, aby przyprowadzili skrzynię Bożą z Karyjatyjarym.
\v 6 A tak przyszedł Dawid, i wszystek Izrael do Baala w Karyjatyjarym, które jest w Judzie, aby przyprowadzili stamtąd skrzynię Pana Boga siedzącego nad Cherubinami, gdzie wzywane bywa imię jego.
\v 7 I wieźli skrzynię Bożą na wozie nowym z domu Abinadabowego, a Oza i Achyjo prowadzili wóz.
\v 8 Lecz Dawid i wszystek Izrael grali przed Bogiem ze wszystkiej mocy, i pieśniami, i na harfach, i na cytrach, i na bębnach, i na cymbałach, i na trąbach.
\v 9 A gdy przyszli na bojewisko Chydon, ściągnął Oza rękę swą, aby zadzierżał skrzynię; bo woły były wystąpiły z drogi.
\v 10 I rozgniewał się bardzo Pan na Ozę, i zabił go, przeto iż ściągnął rękę swą ku skrzyni; i umarł tamże przed Bogiem.
\v 11 I zafrasował się Dawid, iż to rozerwanie Pan uczynił w Ozie; a przetoż nazwał ono miejsce Peres Oza, aż do dnia tego.
\v 12 I uląkł się Dawid Boga dnia onego, a rzekł: Jakoż mam wprowadzić do siebie skrzynię Bożą?
\v 13 Przetoż nie wprowadził Dawid skrzyni do siebie, do miasta Dawidowego; ale ją wprowadził do domu Obededoma Gietejczyka.
\v 14 I została skrzynia Boża między domownikami Obededomowymi w domu jego przez trzy miesiące. I błogosławił Pan domowi Obededomowemu i wszystkiemu, co miał.
\c 14
\v 1 Potem posłał Hiram, król Tyrski, posłów do Dawida, i drzewa cedrowe, i murarzy i cieśli, aby mu zbudowali dom.
\v 2 I poznał Dawid, iż go utwierdził Pam królem nad Izraelem, a iż wywyższył królestwo jego dla ludu swego Izraelskiego.
\v 3 (I pojął Dawid więcej żon w Jeruzalemie, a spłodził Dawid więcej synów i córek.
\v 4 A teć są imiona tych, którzy mu się urodzili w Jeruzalemie: Samna, i Sobab, Natan, i Salomon,
\v 5 I Ibchar, i Elisua, i Elfalet,
\v 6 I Noga, i Nefeg, i Jafija,
\v 7 I Elisama, i Beelijada, i Elifelet.)
\v 8 Wtem usłyszawszy Filistynowie, że był pomazany Dawid za króla nad wszystkim Izraelem, wyciągnęli wszyscy Filistynowie, aby szukali Dawida. Co gdy usłyszał Dawid, wyszedł przeciwko nim.
\v 9 Bo Filistynowie przyciągnąwszy rozpostarli się w dolinie Rafaim.
\v 10 I radził się Dawid Boga, mówiąc: Mamli iść przeciw Filistynom? a podaszli ich w ręce moje? I odpowiedział mu Pan: Idź a podam ich w ręce twoje.
\v 11 A gdy oni przyciągnęli do Baal Perazym, poraził ich tam Dawid, i rzekł Dawid: Rozerwał Bóg nieprzyjacioły moje przez rękę moję, jako się rozrywają wody; a przetoż nazwano imię miejsca onego Baal Perazym.
\v 12 I zostawili tam bogi swoje; a Dawid rozkazał, aby je spalono ogniem.
\v 13 Lecz zebrawszy się znowu Filistynowie rozpostarli się w dolinie.
\v 14 Przetoż radził się znowu Dawid Boga. I rzekł mu Bóg: Nie ciągnij za nimi, ale się odwróć od nich, abyś na nich natarł przeciwko morwom.
\v 15 A gdy usłyszysz szum idącego po wierzchach morwowych, tedy wynijdziesz do bitwy; bo wyszedł Bóg przed tobą, aby poraził wojska Filistyńskie.
\v 16 I uczynił Dawid, jako mu był rozkazał Bóg; i porazili wojska Filistyńskie od Gabaon aż do Gazer.
\v 17 A tak rozsławiło się imię Dawidowe po wszystkich ziemiach: i sprawił to Pan, że był straszny wszystkim narodom.
\c 15
\v 1 A gdy sobie pobudował Dawid domy w mieście swojem, i nagotował miejsce skrzyni Bożej, i rozbił jej namiot,
\v 2 Tedy rzekł Dawid: Niegodzi się nosić skrzyni Bożej jedno Lewitom. Tych bowiem obrał Pan, aby nosili skrzynię Bożą, i służyli mu aż na wieki.
\v 3 Przetoż zebrał Dawid wszystkiego Izraela do Jeruzalemu, aby przeniósł skrzynię Pańską na miejsce jej, które jej był zgotował.
\v 4 I zgromadził Dawid synów Aaronowych i Lewitów.
\v 5 Z synów Kaatowych: Uryjela przedniejszego, i braci jego sto i dwadzieścia,
\v 6 Z synów Merarego: Asajasza przedniejszego, i braci jego dwieście i dwadzieścia.
\v 7 Z synów Giersonowych: Joela przedniejszego, i braci jego sto i trzydzieści.
\v 8 Z synów Elisafanowych: Semejasza przedniejszego, i braci jego dwieście.
\v 9 Z synów Hebronowych: Elijela przedniejszego, i braci jego ośmdziesiąt.
\v 10 Z synów Hasyjelowych: Aminadaba przedniejszego, i braci jego sto i dwanaście.
\v 11 Tedy wezwał Dawia Sadoka i Abijatara, kapłanów, także Lewitów Uryjela, Asajasza, i Joela, Semejasza, i Elijela, i Aminadaba;
\v 12 I rzekł do nich: Wyście przedniejsi z domów ojcowskich między Lewitami; poświęćcież się i z braćmi swoimi, abyście przynieśli skrzynię Pana, Boga Izraelskiego, na miejsce, którem jej nagotował.
\v 13 Albowiem iżeście tego pierwej nie uczynili, uczynił rozerwanie Pan, Bóg nasz, między nami; bośmy go nie szukali według przystojności.
\v 14 Poświęcili się tedy kapłani i Lewitowie, aby przynieśli skrzynię Pana, Boga Izraelskiego.
\v 15 I niesli synowie Lewitów skrzynię Bożą, jako był rozkazał Mojżesz według słowa Pańskiego, na ramionach swych, na drążkach które przy niej były.
\v 16 I rzekł Dawid przedniejszym z Lewitów, aby postanowili z braci swoich śpiewaków z instrumentami muzycznemi, z lutniami, z cytrami, i z cymbałami, aby słyszany był wyniesiony głos z weselem.
\v 17 I postanowili Lewitowie Hemana, syna Joelowego, a z braci jego Asafa, syna Barachyjaszowego, a z synów Merarego, braci ich, Etana syna Chysajowego;
\v 18 A z nimi braci ich w rzędzie wtórym: Zacharyjasza, Bena, i Jazyjela, i Semiramota, i Jechyjela, i Unni, Elijaba, i Benajasza, Maasejasza, i Matytyjasza, i Elifelego, i Miknejasza, i Obededoma, i Jehijela, odźwiernych.
\v 19 A śpiewacy Heman, Asaf, i Etan na cymbałach miedzianych głośno grali.
\v 20 A Zacharyjasz, i Jazyjel, i Semiramot, i Jechyjel, i Unni, i Elijab, i Maasejasz, i Benajasz grali na lutniach przy śpiewaniu wysokiem.
\v 21 A Matytyjasz, i Elifele, i Miknejasz, i Obededom, i Jechyjel, i Azazyjasz grali na cytrach przy śpiewaniu niskiem.
\v 22 A Kienanijasz, przedniejszy z Lewitów, którzy nieśli skrzynię, rozrządzał, jakoby nieść miano; bo był roztropny.
\v 23 Ale Bacharyjasz i Elkana byli odźwiernymi u skrzyni.
\v 24 A Sebanijasz i Jozafat, i Natanael, i Amasaj, i Zacharyjasz, i Benajasz, i Eliezer, kapłani, trąbili w trąby przed skrzynią Bożą; ale Obededom i Jechyjasz byli odźwiernymi u skrzyni.
\v 25 A tak Dawid i starsi Izraelscy, i hetmani nad tysiącami szli, aby przeprowadzili skrzynię przymierza Pańskiego z domu Obededomowego z weselem.
\v 26 I stało się, gdy Bóg wspomógł Lewitów, niosących skrzynię przymierza Pańskiego, że ofiarowali siedm wołów, i siedm baranów.
\v 27 A Dawid był obleczony w szatę bisiorową, także i wszyscy Lewitowie, którzy nieśli skrzynię, i śpiewacy, i Kienanijasz, rządca tych, co nieśli między śpiewakami; a Dawid miał na sobie efod lniany.
\v 28 A tak wszystek Izrael prowadził skrzynię przymierza PaOskiego z weselem, i z hukiem kornetu, i trąby, i cymbałów, grając na lutniach i na cytrach.
\v 29 I stało się, gdy skrzynia przymierza Pańskiego wchodziła do miasta Dawidowego, że Michol, córka Saulowa, wyglądając oknem ujrzała króla Dawida skaczącego, i grającego, i wzgardziła go w sercu swojem.
\c 16
\v 1 A gdy przynieśli skrzynię Bożą, i postawili ją w pośród namiotu, który był Dawid rozbił, tedy sprawowali całopalenia i ofiary spokojne przed Bogiem.
\v 2 A gdy dokończył Dawid ofiarować całopalenia, i ofiar spokojnych, błogosławił ludowi w imię Pańskie.
\v 3 I rozdzielił wszystkim mężom Izraelskim, od męża aż do niewiasty, każdemu po bochenku chleba, i po sztuce mięsa, i po łagiewce wina.
\v 4 A postanowił przed skrzynią Pańską z Lewitów sługu, aby wspominali, i wyznawali, i chwalili Pana, Boga Izraelskiego.
\v 5 Asaf był przedniejszy, a wtóry po nim Zacharyjasz, Jehyjel, i Semiramot, i Jechyjel i Matytyjasz, i Elijab, i Benajasz, i Obededom, i Jechyjel; ci na instrumentach, na lutniach, na harfach, ale Asaf na cymbałach, grali.
\v 6 Benajasz zaś i Jachazyjel kapłani z trąbami ustawiczne byli przed skrzynią przymierza Bożego.
\v 7 Dopiero dnia onego najpierwej postanowił Dawid, aby tym psalmem chwalony był Pan przez Asafa i braci jego:
\v 8 Wysławiajcie Pana, wzywajcie imienia jego, a opowiadajcie między narodami sprawy jego.
\v 9 Śpiewajcie mu, grajcie mu, rozmawiajcie o wszystkich cudach jego.
\v 10 Chlubcie się w imieniu świętem jego, a niech się rozraduje serce szukających Pana.
\v 11 Szukajcie Pana, i mocy jego; szukajcie oblicza jego zawżdy.
\v 12 Wspominajcie dziwne sprawy jego, które czynił, i cuda jego, i sądy ust jego.
\v 13 O nasienie Izraelskie, słudzy jego! O synowie Jakóbowi, wybrani jego!
\v 14 On jest Pan, Bóg nasz; po wszystkiej ziemi sądy jego.
\v 15 Pamiętajcie aż na wieki na przymierze jego, na słowow, które przykazał do tysiącznego pokolenia;
\v 16 Które postanowił z Abrahamem, i na przysięgę jego z Izaakiem;
\v 17 I postanowił to Jakóbowi za prawo, a Izraelowi za przymierze wieczne,
\v 18 Mówiąc: Tobie dam ziemię Chananejską za sznur dziedzictwa waszego.
\v 19 Choć was była mała liczba, a przez krótki czas byliście przychodniami w niej;
\v 20 I przechodzili od narodu do narodu, i od królestwa do innego ludu:
\v 21 Nie dopuścił nikomu, aby ich uciskać miał, i karał dla nich królów,
\v 22 Mówiąc: Nie tykajcie pomazańców moich, a prorokom moim nie czyńcie nic złego.
\v 23 Śpiewajcie Panu wszystka ziemio; opowiadajcie ode dnia do dnia zbawienie jego.
\v 24 Opowiadajcie między narodami chwałę jego, i między wszystkimi ludźmi dziwne sprawy jego;
\v 25 Bo wielki jest Pan, i chwalebny bardzo, i straszniejszy nad wszystkich bogów;
\v 26 Gdyż bogowie pogańscy są bałwanami; ale Pan niebiosa uczynił.
\v 27 Sława i zacność przed nim, moc i wesele na miejscu jego.
\v 28 Przynieście Panu pokolenia narodów, przynieście Panu chwałę i moc.
\v 29 Przynieście Panu chwałę imienia jego, przynieście dary, a przychodźcie przed obliczności jego; kłaniajcie się Panu w ozdobie świętobliwości.
\v 30 Bójcie się oblicza jego wszystka ziemio, a będzie utwierdzony okrąg ziemi, aby się nie poruszył.
\v 31 Niech się rozradują niebiosa, a niech się rozweseli ziemia, a niech mówią w narodach: Pan króluje!
\v 32 Niech zaszumi morze, i ze wszystkiem, co w niem jest; niech się rozraduje pole, i wszystko, co na niem jest.
\v 33 Tedy się rozweselą drzewa leśne przed Panem; albowiem przyszedł sądzić ziemię.
\v 34 Wysłwiajcie Pana; albowiem dobry, bo na wieki trwa miłosierdzie jego.
\v 35 A mówcie: Zachowaj nas, Boże zbawienia naszego! i zgromadź nas, a wyrwij nas od pogan, abyśmy wielbili imię święte twoje, i chlubili się w chwale twojej.
\v 36 Błogosławiony Pan, Bóg Izraelski, od wieków aż na wieki. I rzekł wszystek lud Amen, i chwalił Pana.
\v 37 I zostawił tam Dawid przed skrzynią przymierza Pańskiego Asafa i braci jego, aby służyli przed skrzynią ustawicznie według potrzeby dnia każdego.
\v 38 Lecz Obededoma i braci ich sześdziesiąt i ośm, Obededoma mówię, syna Jedytunowego, i Hosę, uczynił odźwiernymi.
\v 39 A Sadoka kapłana, i braci jego kapłanów postawił przed przybytkiem Pańskim na wyżynie, która była w Gabaon,
\v 40 Aby ofiarowali całopalenia Panu na ołtarzu całopalenia ustawicznie rano i w wieczór, a to według wszystkiego, co napisano w zakonie Pańskim, który przykazał Izraelowi.
\v 41 A z nimi Hemana i Jedytuna, i innych na to obranych, którzy byli z imienia mianowani, aby chwalili Pana, przeto iż na wieki trwa miłosierdzie jego.
\v 42 A między nimi Heman i Jedytun, trąbili i grali na trąbach, na cymbałach, i na innych instrumentach muzycznych Bogu; ale synów Jedytunowych postawił u wrót.
\v 43 A tak rozszedł się wszystek lud, każdy do domu swego. Dawid się też wrócił, aby błogosławił domowi swemu.
\c 17
\v 1 I stało się, gdy mieszkał Dawid w domu swym, że rzekł do Natana proroka: Oto ja mieszkam w domu cedrowym, a skrzynia przymierza Pańskiego pod kortynami.
\v 2 I rzekł Natan do Dawida: Cokolwiek jest w sercu twem, uczyń, gdyż Bóg jest z tobą.
\v 3 Potem onej nocy stało się słowo Boże do Natana, mówiąc:
\v 4 Idź, a mów do Dawida, sługi mego: Tak mówi Pan: Nie ty mi będziesz budował domu do mieszkania;
\v 5 Ponieważem nie mieszkał w domu ode dnia, któregom wywiódł synów Izraelskich, aż do dnia tego: alem się przechadzał z namiotu do namiotu, i z przybytku do przybytku.
\v 6 Wszędzie gdziemkolwiek chodził ze wszystkim Izraelem, izalim i słowo rzekł któremu z sędziów Izraelskich, którymem rozkazał, aby paśli lud mój, mówiąc: Przeczżeście mi nie zbudowali domu cedrowego?
\v 7 Przetoż teraz tak powiesz słudze memu Dawidowi: Tak mówi Pan zastępów: Jam ciebie wziął z owczarni, gdyś chodził za trzodą, abyś był wodzem nad ludem moim Izraelskim;
\v 8 I byłem z tobą wszędzie, gdzieśkolwiek chodził, a wygładziłem wszystkich nieprzyjaciół twoich przed twarzą twoją, i uczyniłem ci imię, jako imię wielkich ludzi, którzy są za ziemi.
\v 9 A postanowiłem miejsce ludowi memu Izraelskiemu, i wszczepiłem go; i będzie mieszkał na miejscu swem, a nie będzie więcej poruszowny, ani go więcej synowie nieprawości trapić, jako przedtem;
\v 10 Zaraz ode dni, którychem postanowił sędziów nad ludem moim Izraelskim, i poniżyłem wszystkich nieprzyjaciół twoich, i oznajmiłem ci, żeć Pan dom zbuduje.
\v 11 A gdy się wypełnią dni twoje, abyś szedł za ojcami twoimi, wzbudzę nasienie twoje po tobie, które będzie z synów twoich, i umocnię królestwo jego.
\v 12 Ten mi zbuduje dom, i utwierdzę stolicę jego aż na wieki.
\v 13 Ja mu będę za ojca a on mi będzie za syna, a miłosierdzia mego nie odejmę od niego, jakom je odjął od tego, który był przed tobą;
\v 14 Owszem postanowię go w domu moim, i w królestwie mojem aż na wieki, a stolica jego będzie trwała aż na wieki.
\v 15 Według tych wszystkich słów i według wszystkiego widzenia tego, tak mówił Natan do Dawida.
\v 16 Zatem wszedłszy król Dawid, siadł przed obliczem Pańskiem, i rzekł: Cóżem ja jest, Panie Boże! co jest dom mój, żeś mię przywiódł aż dotąd?
\v 17 Lecz i to mało było przed oczyma twemi, o Boże! aleś też obietnicę uczynił o domie sługi twego na czas daleki, i wejrzałeś na mię według obyczaju ludzkiego, wywyższając mię, o Panie Boże!
\v 18 Cóż jeszcze więcej ma mówić Dawid przed tobą o uwielbieniu sługi twego? albowiem ty znasz sługę twego.
\v 19 Panie! dla sługi twego i według serca twego uczyniłeś te wszystkie wielkie rzeczy, abyś znajome uczynił te wszystkie wielmożne sprawy.
\v 20 Panie! nie masz podobnego tobie, i nie masz Boga oprócz ciebie, wedle wszystkiego, cośmy słyszeli w uszy nasze.
\v 21 I któż jest jako lud twój, jako Izrael, naród jedyny na ziemi, dla któregoby Bóg szedł, aby go sobie odkupił za lud, a uczynił sobie imię, czyniąc wielkie rzeczy i straszne, wyganiając pogany przed twarzą ludu twego, któryś wykupił z Egiptu?
\v 22 I uczyniłeś lud twój Izraelski sobie za lud aż na wieki, a ty Panie! stałeś się im za Boga.
\v 23 Przetoż teraz, o Panie! słowo, któreś powiedział o słudze twoim, i o domu jego, niech będzie stwierdzone aż na wieki, a uczyń, jakoś powiedział.
\v 24 Niechajże się tak stanie, i niechaj będzie uwielbione imię twoje aż na wieki, aby mówiono: Pan zastępów, Bóg Izraelski, Bogiem jest nad Izraelem; a dom Dawida, sługi twego, niechaj umocniony będzie przed twarzą twoją.
\v 25 Albowiemeś ty, Boże mój! objawił słudze twemu, iż mu zbudujesz dom; przetoż znalazł sługa twój u siebie, aby się modlił przed tobą.
\v 26 A tak o Panie! tyś sam Bóg, a mówiłeś to dobre o słudze swym.
\v 27 Teraz tedy począłeś błogosławić domowi sługi twego, aby trwał na wieki przed tobą; boś ty Panie! jemu błogosławił, a będzie ubłogosławiony na wieki.
\c 18
\v 1 I stało się potem, że poraził Dawid Filistynów i poniżył ich, a wziął Get i wsi jego z rąk Filistynów.
\v 2 Poraził też Moabczyki, i byli Moabczyki sługami Dawidowymi, przynosząc mu hołd.
\v 3 Poraził też Dawid Hadarezera, króla Soby w Emat, gdy był wyjechał, aby rozprzestrzeniał państwo swoje nad rzeką Eufrates.
\v 4 Zabrał mu tedy Dawid tyziąc wozów, i siedm tysięcy jezdnych, i dwadzieścia tysięcy mężów pieszych, i poderznął Dawid żyły wszystkich woźników, zachowawszy z nich koni do sta wozów.
\v 5 Przyciągnęli też Syryjczycy z Damaszku na pomoc Hadarezerowi, królowi Soby; lecz poraził Dawid z Syryjczyków dwadzieścia i dwa tysiące mężów.
\v 6 Tedy Dawid osadził żołnierzem Syryję Damaską, a byli Syryjczycy sługami Dawidowymi, oddawając mu hołd; i zachowywał Pan Dwida, gdzie się kolwiek obrócił.
\v 7 Pobrał też Dawid tarcze złote, które mieli słudzy Hadarezerowi, i wniósł je do Jeruzalemu.
\v 8 Przytem z Tybchat i z Chun, miast Hadarezerowych, nabrał Dawid miedzi bardzo wiele, z której Salomon sprawił morze miedziane, i słupy, i naczynia miedziane.
\v 9 A gdy usłyszał Tohy, król Emat, że poraził Dawid wszystko wojsko Hadarezera, króla Soby.
\v 10 Posłał Adorama, syna swego, do króla Dawida, aby go pozdrowił w pokoju, i aby mu powinszował, przeto, że zwalczył Hadarezera, i poraził go; (albowiem walczył Tohy z Hadarezerem) który przyniósł z sobą wszelakie naczynie złote, i srebrne, i miedziane.
\v 11 Które też poświęcił król Dawid Panu z srebrem i ze złotem, które był pobrał od wszystkich narodów, od Edomczyków, i od Moabczyków, o od synów Ammonowych, i od Filistynów, i od Amalekitów.
\v 12 A Abisaj, syn Sarwii, poraził Edomczyków w dolinie solnej ośmnaście tysięcy.
\v 13 I osadził Edomską ziemię żołnierzem: a byli wszyscy Edomczycy sługami Dawidowymi: i zachowywał Pan Dawida wszędzie, gdzie się obrócił.
\v 14 A tak królował Dawid nad wszystkim Izraelem, czyniąc sąd i sprawiedliwość wszystkiemu ludowi swemu.
\v 15 A był Joab, syn Sarwii, nad wojskiem, a Jozafat, syn Ahiludowy, kanclerzem.
\v 16 A Sadok, syn Achitobowy, i Abimelech, syn Abijatara, byli kapłanami, a Susa był pisarzem.
\v 17 Benajasz też, syn Jojady, był przełożonym nad Cheretczykami i Feletczykami; a synowie Dawidowi byli pierwszymi przy boku królewskim.
\c 19
\v 1 I stało się potem, że umarł Nahas, król synów Ammonowych, a syn jego królował miasto niego.
\v 2 Tedy rzekł Dawid: Uczynię miłosierdzie nad Hanonem, synem Nahasowym; bo ojciec jego uczynił miłosierdzie nademną. I posłał Dawid posłów, aby go cieszyli po ojcu jego; a tak przyszli słudzy Dawidowi do ziemi synów Ammonowych, do Hanona, aby go cieszyli.
\v 3 Ale rzekli książęta synów Ammonowych do Hanona: Mniemasz, żeby Dawid czynił uczciwość ojcu twemu, iż przysłał do ciebie tych, którzyby cię cieszyli; azaż nie dla tego, aby wypatrzyli i wyszpiegowali, i zburzyli tę ziemię, przyszli słudzy jego do ciebie?
\v 4 Przetoż wziąwszy Hanon sługi Dawidowe, ogolił je, i pobrzynał szaty ich od połowy aż do zadków, i puścił ich.
\v 5 Poszli tedy niektórzy, i oznajmili Dawidowi o tych mężach. I posłał przeciwko nim, (ponieważ byli oni mężowie zelżeni bardzo,) i rzekł im król: Zostańcie w Jerycho, aż odrosną brody wasze, potem się wrócicie.
\v 6 A widząc synowie Ammonowi, że się obrzydłymi stali Dawidowi, posłał Hanon i synowie Ammonowi tysiąc talentów srebra, aby sobie najęli za te pieniądze z Mezopotamii i z Syryi Maacha, i z Soby wozy i jezdnych.
\v 7 I najęli sobie za one pieniądze trzydzieści i dwa tysiące wozów, i króla Maacha z ludem jego. Którzy przyciągnąwswzy położyli się obozem przeciw Medeba; a synowie Ammonowi zebrawszy się z miast swych, stawili się do bitwy.
\v 8 Co gdy usłyszał Dawid, posłał Joaba ze wszystkiem wojskiem ludu rycerskiego.
\v 9 A tak wyciągnąwszy synowie Ammonowi uszykowali się do bitwy przed bramą miejską. Królowie zasię, którzy byli przyszli na pomoc, osobno w polu byli.
\v 10 Przetoż widząc Joab uszykowane przeciwko sobie wojsko do bitwy z przodku i z tyłu, wybrał niektórych ze wszystkich przebranych z Izraela, i uszykował wojsko przeciw Syryjczykom.
\v 11 A ostatek ludu dał pod rękę Abisajemu, bratu swemu; i uszykowali się przeciw synom Ammonowym.
\v 12 I rzekł Joab: Jeźli mi będą silnymi Syryjczycy, przyjdziesz mi na pomoc, i jeźli tobie synowie Ammonowi będą silnymi, ja tobie dam pomoc.
\v 13 Zmacniej się, a bądźmy mążnymi za lud nasz, i za miasta Boga naszego, a Pan, co dobrego jest w oczach jego, niech uczyni.
\v 14 Nastąpił tedy Joab, i lud, który z ni był, do bitwy przeciwko Syryjczykom; ale oni uciekli przed nim.
\v 15 Tedy synowie Ammonowi ujrzawszy, że uciekali Syryjczycy, uciekli i oni przed Abisaim, bratem jego, i uszli do miasta; a Joab wrócił się do Jeruzalemu.
\v 16 A tak widząc Syryjczycy, iż byli porażeni od Izraela, wyprawili posłów, i wywiedli Syryjczyków, którzy byli za rzeką, a Sobach, hetman wojska Hadarezerowego, prowadził ich.
\v 17 I oznajmiono to Dawidowi, który zebrawszy wszystkiego Izraela przeprawił się przez Jordan, a przyciągnąwszy do nich uszykował wojsko przeciwko nim; a gdy uszykował wojsko Dawid przeciwko Syryjczykom ku bitwie, zwiedli z nim bitwę.
\v 18 Tedy uciekli Syryjczycy przed Izraelem, i poraził Dawid z Syryjczyków siedm tysięcy wozów, i czterdzieści tysięcy mężów pieszych, i Sobacha, hetmana wojska onego, zabił.
\v 19 Przetoż gdy ujrzeli słudzy Hadarezerowi, iż byli porażeni od Izraela, uczynili pokój z Dawidem, i służyli mu. I nie chcieli napotem Syryjczycy dawać pomocy synom Ammonowym.
\c 20
\v 1 I stało się po roku tego czasu, gdy królowie zwykli wyjeżdżać na wojnę, iż wywiódł Joab co mężniejsze rycerstwo, i pustoszył ziemię synów Ammonowych, a przyciągnąwszy obległ Rabbę; (lecz Dawid zostawał w Jeruzalemie) i dobył Joab Rabby, i zburzył ją.
\v 2 I wziął Dawid koronę króla ich z głowy jego, a znalazł w niej talent złota, i kamienie bardzo drogie. I włożono ją na głowę Dawidową, i wywiózł łupów z miasta bardzo wiele.
\v 3 Lud też, który był w nim, wywiódł, i dał ich potrzeć piłami i wozami żelaznemi, i porąbać siekierami. Takci uczynił Dawid wszystkim miastom synów Ammonowych, i wrócił się Dawid ze wszystkim ludem do Jeruzalemu.
\v 4 Potem znowu gdy była wojna w Gazer z Filistynami, zabił Sobbochaj Husatczyk Syfę, który był z narodu olbrzymów; a tak Filistynowie poniżeni są.
\v 5 Była też jeszcze wojna z Filistynami, gdzie zabił Elchana, syn Jairowy, Lachmiego, brata Golijata Gietejczyka, którego drzewce u włóczni było nawój tkacki.
\v 6 Nadto jeszcze była wojna w Get, gdzie był mąż wzrostu wielkiego, mając po sześć palców, wszystkich dwadzieścia i cztery; a ten też był z narodu tegoż olbrzyma.
\v 7 Ten gdy urągał Izraelowi, zabił go Jonatan, syn Samaja, brata Dawidowego.
\v 8 Ci byli synowie jednego olbrzyma z Get, którzy polegli od ręki Dawidowej, i od ręki sług jego.
\c 21
\v 1 Ale szatan powstał przeciw Izraelowi a pobudził Dawida, aby policzył Izraela.
\v 2 Przetoż rzekł Dawid do Joaba i do przełożonych nad ludem: Idźcie, obliczcie Izraela od Beerseba aż do Dan, a odnieście do mnie, żebym wiedział poczet ich.
\v 3 Ale rzekł Joab: Niech przymnoży Pan ludu swego, jako teraz jest, tyle sto kroć; izali królu, panie mój! nie są wszyscy oni sługami pana mego? Przeczże się tego dowiaduje pan mój? Przeczżeby to miało być na upadek Izraelowi?
\v 4 Wszakże słowo królewskie przemogło Joaba; przetoż wyszedł Joab, a obszedłszy wszystkiego Izraela, wrócił się potem do Jeruzalem.
\v 5 I oddał Joab poczet porachowanego ludu Dawidowi. A było wszystkiego Izraela tysiąc tysięcy i sto tysięcy, mężów godnych ku bojowi; a z Judy było cztery kroć sto tysięcy, i siedmdziesięt tysięcy mężów walecznych.
\v 6 Lecz Lwitów i Benjamitów nie policzył między nich, gdyż przykre było rozkazanie królewskie Joabowi.
\v 7 Owszem nie podobała się Bogu ta rzecz; przetoż pokarał Izraela.
\v 8 I rzekł Dawid do Boga: Zgrzeszyłem bardzo, żem to uczynił; ale teraz oddal, proszę, nieprawość sługi twego; bom bardzo głupio uczynił.
\v 9 Zatem rzekł Pan do Gada, proroka Dawidowego, mówiąc:
\v 10 Idź, powiedz Dawidowi, a rzecz: Tak mówi Pan: Trzyć rzeczy podaję; obierz sobie jednę z nich, abym ci czynił.
\v 11 Tedy przyszedł Gad do Dawida, i rzekł mu: Tak mówi Pan: Obierz sobie:
\v 12 Albo przez trzy lata głód, albo żebyś przez trzy miesiące ginął od nieprzyjaciół twych, a miecz nieprzyjaciół twoich żeby cię ścigał, albo żeby przez trzy dni miecz Pański i mor był w ziemi, a Anioł Pański żeby niszczył wszystkie granice Izraelskie. Przetoż teraz uważ, co mam odpowiedzieć temu, który mię posłał.
\v 13 I rzekł Dawid do Gada: Bardzom ściśniony; niech wpadnę, proszę, w ręce Pańskie, gdyż bardzo wielkie są zlitowania jego, a w ręce ludzkie niechaj nie wpadam.
\v 14 Tedy przepuścił Pan powietrze morowe na Izraela. I poległo z Izraela siedmdziesiąt tysięcy mężów.
\v 15 Posłał też Bóg Anioła do Jeruzalemu, aby ich tracił. A gdy ich tracił, ujrzał Pan, i użalił się nad tem złem, i rzekł Aniołowi tracącemu: Dosyć już, zawściągnij rękę twą. A Anioł Pański stał podle bojewiska Ornana Jebuzejczyka.
\v 16 Wtem podniósłszy Dawid oczy swe ujrzał Anioła Pańskiego, który stał między ziemią i między niebem, a w ręce jego miecz jego dobyty, wyciągniony przeciw Jeruzalemowi. I upadł Dawid i starsi, oblekłszy się w wory, na twarze swoje.
\v 17 Zatem rzekł Dawid do Boga: Izalim nie ja rozkazał liczyć ludu? Jamci jest sam, którym zgrzeszył, i bardzo źle uczynił; ale te owce cóż uczyniły? Panie, Boże mój! niech się obróci, proszę, ręka twoja na mię i na dom ojca mego; ale przeciwko ludowi twemu niech się nie sroży ta plaga.
\v 18 Zatem Anioł Pański rzekł do Gada, aby mówił Dawidowi, żeby szedł i zbudował ołtarz Panu na bojewisku Ornana Jebuzejczyka.
\v 19 A tak szedł Dawid według słowa Gadowego, które mówił imieniem Pańskiem.
\v 20 Tedy obejrzawszy się Ornan ujrzał onego Anioła; a czterej synowie jego, którzy byli z nim, skryli się; a Ornan młócił pszenicę.
\v 21 Wtem przyszedł Dawid do Ornana; a spojrzawszy Ornan obaczył Dawida, i wyszedłszy z bojewiska, pokłonił się Dawidowi twarzą do ziemi.
\v 22 I rzekł Dawid do Ornana: Daj mi plac tego bojewiska, abym zbudował na nim ołtarz Panu; za słuszne pieniądze spuść mi je, a będzie odwrócona ta plaga od ludu.
\v 23 I rzekł Ornan do Dawida: Weźmij je sobie, a niech uczyni król, pan mój, co mu się dobrego widzi; otoć przydaję i woły na całopalenia, i wóz na drwa, i pszenicę na ofiarę śniedną: toć to wszystko daję.
\v 24 I rzekł król Dawid do Ornana: Nie tak, ale raczej kupię za słuszne pieniądze; bo nie wezmę co twego jest, ani będę ofiarował Panu całopalenia darowanego.
\v 25 A tak Dawid dał Ornanowi za on plac sześć syklów złota dobrej wagi.
\v 26 I zbudował tam Dawid ołtarz Panu, a ofiarował całopalenia i ofiary spokojne, i wzywał Pana, który go wysłuchał, spuściwszy ogień z nieba na ołtarz całopalenia.
\v 27 I rzekł Pan do Anioła, aby obrócił miecz swój w pochwy swoje.
\v 28 Onego czasu widząc Dawid, iż go wysłuchał Pan na bojewisku Ornana Jebuzejczyka, ofiarował tam ofiary.
\v 29 Albowiem przybytek Pański, który uczynił Mojżesz na puszczy, i ołtarz całopalenia, naonczas był na wyżynie w Gabaonie.
\v 30 A nie mógł Dawid iść do niego, aby się radził Boga; bo przestraszony był mieczem Anioła Pańskiego.
\c 22
\v 1 I rzekł Dawid: Toć jest miejsce domu Pana Boga, i to ołtarz na całopalenie Izraelowi.
\v 2 Przetoż rozkazał Dawid, aby zgromadzono cudzoziemców, którzy byli w ziemi Izraelskiej; i postanowił z nich kamienników, aby ciosali kamienie czworograniaste na budowanie domu Bożego.
\v 3 Żelaza taż bardzo wiele na gwoździe, i na drzwi w bramach, i na spajanie nagotował Dawid, i miedzi wagę niezliczoną.
\v 4 Drzewa taż cedrowego bez liczby, albowiem nawieźli Dawidowi Sydończycy i Tyryjczycy drzewa cedrowego bardzo wiele.
\v 5 Bo rzekł był Dawid: Salomon, syn mój, jest młodzieńczykiem małym, a dom ma być zbudowany Panu wielki i znamienity, któregoby imię i sława po wszystkiej ziemi była; przetoż teraz nagotuję mu potrzeb. I nagotował Dawid przed śmiercią swą bardzo wiele potrzeb.
\v 6 Tedy zawołał Salomona, syna swego, a przykazał mu, aby zbudował dom Panu, Bogu Izraelskiemu.
\v 7 I rzekł Dawid do Salomona: Synu mój! Umyśliłem był w sercu mojem, zbudować dom imieniowi Pana Boga mego.
\v 8 Ale się stało do mnie słowo Pańskie, mówiąc: Wieleś krwi rozlał, i wielkieś wojny prowadził; nie będziesz budował domu imieniowi memu, przeto żeś wiele krwi rozlał na ziemię przedemną,
\v 9 Oto syn, któryć się urodzi, będzie mężem spokojnym; bo mu dam odpocznienie od wszystkich nieprzyjaciół jego zewsząd. Przetoż Salomon będzie imię jego; albowiem pokój i odpocznienie dam Izraelowi za dni jego.
\v 10 On zbuduje dom imieniowi memu; on mi będzie za syna, a ja mu będę za ojca, i utwierdzę stolicę królestwa jego nad Izraelem aż na wieki.
\v 11 Przetoż Pan będzie z tobą, synu mój! I będzieć się szczęściło, i zbudujesz dom Pana, Boga twego, jako mówił o tobie.
\v 12 Wszakże niech ci da Pan roztropność, i zmysł, a niech cię postanowi nad Izraelem, abyś strzegł zakonu Pana Boga twego.
\v 13 Tedy szczęśliwym będziesz, jeźli strzedz i czynić będziesz przykazania i sądy, które rozkazał Pan przez Mojżesza Izraelowi. Zmacniajże się, a bądź mężem, nie bój się ani się lękaj.
\v 14 A otom ja w utrapieniu mojem nagotował na dom Pański złota sto tysięcy talentów, i srebra tysiąc tysięcy talentów do tego miedzi i żelaza bez wagi, bo tego wiele jest: drzewa także, i kamienia nagotowałem, a ty do tego przyczynisz.
\v 15 Masz też u siebie wiele rzemieślników, kamiennikówi i murarzy, i cieśli, i wszelkich biegłych w każdem rzemieśle.
\v 16 Złota, srebra, i miedzi, i żelaza niemasz liczby; wstańże a czyń, a Pan będzie z tobą.
\v 17 I przykazał Dawid wszystkim książętom Izraelakim, aby pomagali Salomonowi synowi jego;
\v 18 Mówiąc: Izali Pan Bóg wasz nie jest z wami, który wam dał odpocznienie zewsząd? Bo dał w rękę moję obywateli tej ziemi, i poddane jest ta ziemia Panu i ludowi jego.
\v 19 Teraz tedy oddajcie serce swe i duszę swoję, abyście szukali Pana, Boga waszego; i wstańcie, a budujcie świątnicę Panu Bogu, żebyście tam wnieśżli skrzynię przymierza Pańskiego, i naczynia święte Boże, do domu, który będzie zbudowany imieniowi Pańskiemu.
\c 23
\v 1 A tak Dawid będąc stary i pełen dni, postanowił królem Salomona, syna swego nad Izraelem.
\v 2 I zgromadził wszystkich książąt Izraelskich, i kapłanów, i Lewitów;
\v 3 A policzono Lewitów od trzydziestu lat i wyżej; i był poczet ich według głów ich osób trzydzieści i ośm tysięcy.
\v 4 Z których postanowiono na posługę domu Pańskiego dwadzieścia i cztery tysiące, a przełożonych i sędziów sześć tysięcy.
\v 5 Nadto cztery tysiące odźwiernych, i cztery tysiące chwalących Pana na instrumentach, których nasprawiał Dawid ku chwaleniu Boga.
\v 6 I rozdzielił ich Dawid na pewne hufy według synów Lewiego, to jest, Giersona, Kaata, i Merarego.
\v 7 Z Giersona byli Laadam, i Semej.
\v 8 Synowie Laadanowi: przedniejszy Jachijel, i Zetam, i Joel, ci trzej.
\v 9 Synowie Semejowi: Salomit, i Hazyjel, i Haran, ci trzej. Cić byli przedniejsi domów ojcowskich z Laadana.
\v 10 A synowie Semejowi: Jachat, Zyna, i Jehus, i Baryjasz; cić synowie Semejowi czterej.
\v 11 A Jachat był pierwszym, a Zyza wtóry; ale Jehus i Baryjasz nie mieli wiele synów; przetoż byli w domu ojcowskim policzeni za jednę familiję.
\v 12 Synowie Kaatowi: Amram, Izaar, Hebron, i Husyjel, czterej.
\v 13 Synowie Amramowi: Aaron i Mojżesz. Lecz Aaron był odłączony, aby służył w świątnicy najświętszej, sam i synowie jego aż na wieki, i aby kadzili przed Panem, a służyli mu, i błogosławili w imieniu jego aż na wieki.
\v 14 Ale synowie Mojżesza, męża Bożego, policzeni są w pokoleniu Lewiego.
\v 15 Synowie Mojżeszowi: Gierson i Eliezer.
\v 16 Synowie Giersonowi: Sebujel pierwszy.
\v 17 A synowie Eliezerowi byli Rechabijasz pierwszy. I nie miał Eliezer synów innych; ale synowie Rechabijaszowi rozmnożyli się bardzo.
\v 18 Synowie Izaarowi: Salomit pierwszy.
\v 19 Synowie Hebronowi: Jeryjasz pierwszy, Amaryjasz wtóry, Jehazyjel trzeci, a Jekmaan czwarty.
\v 20 Synowie Husyjelowi: Micha pierwszy, a Jesyjasz wtóry.
\v 21 Synowie Merarego: Mahelin i Musy; a synowie Mahelego: Eleazar i Cys.
\v 22 I umarł Eleazar, a nie miał synów, tylko córki, które pojmowali synowie Cysowi, bracia ich.
\v 23 Synowie Musy: Maheli, i Eder, i Jerymot, trzej.
\v 24 Cić są synowie Lewiego według domów ojców swych, przedniejsi domów ojcowskich, którzy policzeni byli według pocztu imion i osób swych z osobna, którzy odprawowali prace usługiwania w domu Pańskim od dwudziestu lat i wyżej.
\v 25 Albowiem rzekł Dawid: Dał odpocznienie Pan, Bóg Izraelski, ludowi swemu, i będzie mieszkał w Jeruzalemie aż na wieki.
\v 26 Do tego i Lewitowie nie będą więcej nosić przybytku i wszystkiego naczynia jego ku posługiwaniu jego;
\v 27 Ale według postanowienia Dawidowego ostatniego, byli policzeni synowie Lewiego od dwudziestu lat i wyżej;
\v 28 Aby zostawali pod ręką synów Aaronowych ku usłudze domu Pańskiego w przysionkach i w gmachach, i ku oczyszczaniu wszelkich rzeczy poświęconych, i ku pracy około usługi domu Bożego;
\v 29 I około chleba pokładnego, i około mąki na ofiarę, i około placków niekwaszonych, i około panewek, i około rzeczy smażonych, i około wszelkiej miary i odmierzania;
\v 30 A iżby stali na każdy poranek ku wysławianiu, i ku chwaleniu Pana, także i w wieczór;
\v 31 Nadto, przy każdem ofiarowaniu całopalenia Panu w sabaty, na nowiu miesiąca, i w uroczyste święta, według liczby i porządku ich ustawicznie przed Panem;
\v 32 A tak aby pilnowali straży namiotu zgromadzenia, i straży świątnicy, i straży synów Aaronowych, braci swych, w usłudze domu Pańskiego.
\c 24
\v 1 A synowie Aaronowi tym sposobem rozdzieleni byli: Synowie Aaronowi byli Nedab i Abiju, Eleazar i Itamar;
\v 2 Ale iż Nadab i Abiju umarli przed obliczem ojca swego, a synów nie mieli: przetoż odprawowali urząd kapłański Eleazar i Itamar.
\v 3 I podzielił ich Dawid, to jest Sadoka z synów Eleazarowych, i Achimelecha z synów Itamarrowych, według urzędu ich w usługach ich.
\v 4 I znalazło się synów Eleazarowych więcej przedniejszych mężów, niż synów Itamarowych, gdy ich podzielił. Z synów Eleazarowych było przedniejszych według domów ojcowskich szesnaście; ale synów Itamarowych według domów ojcowskich ośm.
\v 5 A rozdzieleni są losem jedni od drugich; bo byli przełożonymi nad świątnicą, i przedniejszymi przed Bogiem, tak z synów Eleazarowych, jako i z synów Itamarowych.
\v 6 A popisał ich Senejasz, syn Natanaelowy, pisarz, z pokolenia Lewiego, przed królem i psiążętami, i przed Sadokiem kapłanem, i Achimelechem, synem Abijatarowym, i przedniejszymi z domów ojcowskich, kapłanów i Lewitów; a naznaczono jeden dom ojcowsk i Eleazarowi, a drugi naznaczono Itamarowi.
\v 7 I padł los pierwszy na Jehojaryba, na Jedajasza wtóry;
\v 8 Na Haryma trzeci, na Seoryma czwarty;
\v 9 Na Malchyjasza piąty, na Mijamana szósty;
\v 10 Na Akkosa siódmy, na Abijasza ósmy;
\v 11 Na Jesuego dziewiąty, na Sechenijasza dziesiąty;
\v 12 Na Eliasyba jedenasty, na Jakima dwunasty;
\v 13 Na Huppa trzynasty, na Jesebaba czternasty;
\v 14 Na Bilgę piętnasty, na Immera szesnasty;
\v 15 Na Chezyra siedmnasty, na Happisesa ośmnasty;
\v 16 Na Petachyjasza dziewiętnasty, na Ezechyjela dwudziesty;
\v 17 Na Jachyna dwudziesty i pierwszy, na Gamuela dwudziesty i wtóry;
\v 18 Na Delajasza dwudziesty i trzeci, na Maazyjasza dwudziesty i czwarty.
\v 19 Cić są sporządzeni w posługiwaniu swojem, aby wchodzili do domu Pańskiego w przemianach swych, jako zwykli pod rządem Aarona, ojca ich, jako mu był rozkazał Pan, Bóg Izraelski.
\v 20 A z synów Lewiego, którzy byli pozostali z synów Amramowych, Subajel; z synów Subajelowych Jechdejasz.
\v 21 Z Rechabijasza, z synów Rechabijaszowych był przednjiejszy Jesyjasz.
\v 22 Z Isaary Salomit, z synów Salomitowych Jachat.
\v 23 A synowie Jeryjaszowi: Amaryjasz wtóry, Jehazylej trzeci, Jekmaan czwarty.
\v 24 Synowie Husyjelowi Micha; z synów Michy Samir.
\v 25 Brat Michasowy Jesyjasz; z synów Jesyjaszowych Zacharyjasz.
\v 26 Synowie Merarego: Maheli i Musy: synowie Jahasyjaszowi Beno.
\v 27 Sunowie Merarego z Jahasyjasza: Beno, i Soam, i Zachur, i Hybry.
\v 28 Z Mahalego Eleazar, który nie miał synów.
\v 29 Z Cysa, synowie Cysowi Jerahmeel.
\v 30 A synowie Musy: Maheli i Eder, i Jerymot. Cić byli synowie Lewitów według domów ojców ich.
\v 31 I ci też miotali losy naprzeciwko braci swoich, synom Aaronowym, przed Dawidem królem, i Sadokiem, i Achimelechem, i przedniejszymi domów ojcowskich, z kapłanów i Lewitów, z domów ojcowskich, każdy przedniejszy przeciwko bratu swemu młodszemu.
\c 25
\v 1 I odłączył Dawid i hetmani wojska na posługiwanie synów Asafowych i Hemanowych, i Jedytunowych, którzy prorokowali przy cytrach, i przy harfach, i przy cymbałach. A była liczba ich, to jest mążów pracujących w usłudze swej:
\v 2 Z synów Asafowych: Zachur, i Józef, i Natanijasz, i Asarela. Synowie Asafowi byli pod ręką Asafową, który prorokował na rozkazanie królewskie.
\v 3 Z Jedytuna: Synowie Jedytunowi: Godolijasz, i Zery, i Jesajasz, Hasabijasz, i Matytyjasz, i Symej, sześć, pod ręką ojca ich Jedytuna, który prorokował przy harfie, wyznawając i chwaląc Pana.
\v 4 Z Hemana: Synowie Hemanowi: Bukkijasz, Matanijasz, Husyjel, Zebuel, i Jerymot, Chananijasz,Chanani, Eliata, Gieddalty, i Romantyjeser, i Jasbekassa, Malloty, Hotyr, Machazyjot.
\v 5 Ci wszyscy byli synowie Hemana, widzącego królewskiego w słowach Bożych, ku wywyższeniu rogu: bo dał Bóg czternaście synów Hemanowych, i trzy córki.
\v 6 Ci wszyscy byli pod sprawą ojca swego przy śpiewaniu w domu Pańskim na cymbałach, na lutniach, i na cytrach ku służbie w domu Bożym, jako rozkazał król, i Asaf, Jedytun, i Heman.
\v 7 A był poczet ich z braci ich, którzy byli ćwiczonymi w pieśniach Pańskich, wszystkich mistrzów dwieście ośmdziesiąt i ośm.
\v 8 I miotali losy, straż przeciwko straży, tak mały jako i wielki, tak mistrz jako i uczeń.
\v 9 I padł los pierwszy w domu Asafowym na Józefa; na Godolijasza wtóry, z braćmi jego i z synami jego, których było dwanaście.
\v 10 Na Zachura trzeci, na synów jego i na braci jego dwanaście.
\v 11 Czwarty na Isrego, na synów jego i na braci jego dwanaście.
\v 12 Piąty na Natanijasza, na synów jego i na braci jego dwanaście.
\v 13 Szósty na Bukkijasza, na synów jego i na braci jego dwanaście.
\v 14 Siódmy na Jesarela, na synów jego i na braci jego dwanaście.
\v 15 Osmy na Jesajasza, na synów jego i na braci jego dwanaście.
\v 16 Dziewiąty na Matanijasza, na synów jego i na braci jego dwanaście.
\v 17 Dziesiąty na Symejasza, na synów jego i na braci jego dwanaście.
\v 18 Jedenasty na Asarela, na synów jego i na braci jego dwanaście.
\v 19 Dwunasty na Hasabijasza, na synów jego i na braci jego dwanaście.
\v 20 Trzynasty na Subajela, na synów jego i na braci jego dwanaście.
\v 21 Czternasty na Matytyjasza, na synów jego i na braci jego dwanaście.
\v 22 Piętnasty na Jerymota, na synów jego i na braci jego dwanaście.
\v 23 Szesnasty naChananijasza, na synów jego i na braci jego dwanaście.
\v 24 Siedemnasty na Jesbekassa, na synów jego i na braci jego dwanaście.
\v 25 Ośmnasty na Chananijego, na synów jego i na braci jego dwanaście.
\v 26 Dziewiętnasty na Mallotego, na synów jego i na braci jego dwanaście.
\v 27 Dwudziesty na Elijata, na synów jego i na braci jego dwanaście.
\v 28 Dwudziesty i pierwszy na Hotyra, na synów jego i na braci jego dwanaście.
\v 29 Dwudziesty i wtóry na Gieddaltego, na synów jego i na braci jego dwanaście.
\v 30 Dwudziesty i trzeci na Machazyjota, na synów jego i na braci jego dwanaście.
\v 31 Dwudziesty i czwarty na Romantyjesera, na synów jego i na braci jego dwanaście.
\c 26
\v 1 Roździały zaś odźwiernych były z Korejczyków: Meselemijasz, syn Korego, z synów Asafowych.
\v 2 A z Meselemijaszowych synów: Zacharyjasz pierworodny, Jadyjael wtóry, Zabadyjasz trzeci, Jatnijel czwarty.
\v 3 Elam piąty, Jachanan szósty, a Elienaj siódmy.
\v 4 A z Obededomowych synów: Semajasz pierworodny, Jozabad wtóry, Joach trzeci, i Sachar czwarty, a Natanael piąty,
\v 5 Ammijel szósty, Isaschar siódmy, Pechulletaj ósmy; bo mu Bóg błogosławił.
\v 6 Semajaszowi też, synowi jego, zrodzili się synowie, którzy panowali w domu ojca swego; bo byli mężowie bardzo mocni.
\v 7 Synowie Semajaszowi: Otni, i Rafael i Obed, Elzabed, bracia jego, mężowie mocni, Elihu i Semachyjasz.
\v 8 Wszyscy ci z synów Obededomowych, sami i synowie ich, i bracia ich, każdy z nich bardzo mocny i sposobny ku posługiwaniu, sześdziesiąt i dwa wszystkich z Obededoma.
\v 9 A z Meselemijaszowych synów i braci, mężów mocnych, ośmnaście.
\v 10 A z Hosy, który był z synów Merarego, synowie byli: Semry przedniejszy; nie iżby był pierworodny, ale iż go ojciec jego uczynił przedniejszym;
\v 11 Helkijasz wtóry, Tebalijasz trzeci, Zacharyjasz czwarty; wszystkich synów i braci trzynaście.
\v 12 Ci są rozdzieleni na odźwiernych, aby byli wrotnymi z mężów przedniejszych, trzymając straż na przemiany z braćmi swymi przy służbie w domu Pańskim.
\v 13 Albowiem miotali losy, tak mały jako wielki według domów ojców swych, o każdą bramę.
\v 14 I padł los na wschód słońca Selemijaszowy; Zacharyjaszowi także synowi jego, radcy mądremu, rzucili losy, i padł los jego na północy;
\v 15 A Obededomowi na południe; ale synom jego na dom skarbów.
\v 16 Suppimowi i Hozie na zachód z bramą Zallechet, przy scieszce usypanej, idącej ku górze; a tak była straż na przeciwko straży.
\v 17 Na wschód słońca było Lewitów sześć, na północy na dzień czterech, na południe na dzień czterech, a przy domu skarbów dwóch a dwóch.
\v 18 Przy stronie zewnętrznej na zachód było czterech na drodze sypanej, a dwóch przy stronie zewnętrznej.
\v 19 Teć są roździeły odźwiernych z synów Korego, i z synów Merarego.
\v 20 A z drugich Lewitów Achyjasz był nad skarbami domu Bożego, to jest nad skarbami rzeczy poświęconych.
\v 21 Synowie Laadanowi, którzy byli z synów Giersonickich: z Laadana Giersończyka przedniejsi w domach ojcowskich, Jehyjel.
\v 22 A synowie Jehyjlowi byli Zetam, i Joel, brat jego; ci byli nad skarbami domu Pańskiego.
\v 23 Z Amramczyków, i z Izaarczyków, z Hebrończyków, i Hysyjelczyków.
\v 24 Był Sebuel, syn Giersona, syna Mojżeszowego, przełożony nad skarbami.
\v 25 Ale bracia jego z Eleazara byli Rechabijasz syn jego, i Jesajasz syn jego, i Joram syn jego, i Zychry syn jego, i Salomit syn jego.
\v 26 Ten Salomit i bracia jego byli na wszystkiemi skarbami rzeczy poświęconych, które był poświęcił Dawid król, i przedniejsi z domów ojcowskich, i półkownicy, i rotmistrze, i hetmani wojska.
\v 27 Bo z wojen i z łupów poświęcali na poprawę domu Pańskiego;
\v 28 I wszystko, co był poświęcił Samuel widzący, i Saul, syn Cysowy, i Abner, syn Nera, i Joab, syn Sarwii, i ktokolwiek co poświęcał, oddawał do rąk Salomitowych i braci jego.
\v 29 Z Izaarytów: Kienanijasz i synowie jego nad robotą zewnętrzną w Izraelu, byli za urzędników i za sędziów.
\v 30 Z Hebrończyków: Hasabijasz i braci jego, mężów dużych, było tysiąc i siedm set przełożonych nad Izraelem za Jordanem na zachód słońca, w każdej robocie Pańskiej i w posłudze królewskiej.
\v 31 A z Hebrończyków był Jeryjasz przedniejszy nad Hebrończykami według narodów ich i domów ojcowskich. Bo roku czterdziestego królestwa Dawidowego szukano i znaleziono między nimi mężów bardzo mocnych w Jazer Galaadskiem.
\v 32 A braci jego, mężów godnych, było dwa tysiące i siedm set przedniejszych w domach ojcowskich. I postanowił ich Dawid król nad Rubeńczykami, i nad Gadczykami, i nad połową pokolenia Manasesowego, nad wszystkiemi sprawami Bożemi i sprawami królewskiemi.
\c 27
\v 1 A synów Izraelskich według liczby ich, przedniejszych w domach ojcowskich, i półkowników, i rotmistrzów, i przełożonych nad tymi, którzy służyli królowi we wszelkiej potrzebie, w podziałach swoich, przychodzących i odchodzących na każdy miesiąc przez wszystkie miesiące w roku; w każdym podziale było dwadzieścia i cztery tysiące.
\v 2 Nad hufem pierwszego miesiąca był Jasobeam, syn Sabdyjelowy, a w podziele jego było dwadzieścia i cztery tysiące.
\v 3 Ten był z synów Faresowych przedniejszym nad wszystkiemi przełożonymi w wojsku miesiąca pierwszego.
\v 4 A nad podziałem wtórego miesiąca był Dodaj Achochytczyk i z podziałem swym; po nim Michlot, książę, a w podziale jego było ludu dwadzieścia i cztery tysiące.
\v 5 Przełożony trzeci wojska miesiąca trzeciego był Banajas, syn Jojady kapłana, przedniejszym, a w podziale jego dwadzieścia i cztery tysiące.
\v 6 Ten Banajas był mocarz między trzydziestoma, i nad trzydziestoma, a nad podziałem jego był Ammisadab, syn jego.
\v 7 Czwarty czwartego miesiąca był Asael, brat Joabowy, a po nim Zabadyjasz, syn jego, a w podziale jego dwadzieścia i cztery tysiące.
\v 8 Piąty miesiąca piątego był przełożonym Samut Jezrahytczyk, a w podziale jego dwadzieścia i cztery tysiące.
\v 9 Szósty miesiąca szóstego był Hyra, syn Ikkiessa Tekuitczyka, a w podziale jego dwadzieścia i cztery tysiące.
\v 10 Siódmy miesiąca siódmego był Heles Felonitczyk z synów Efraimowych, a w podziale jego dwadzieścia i cztery tysiące.
\v 11 Osmy miesiąca ósmego był Sobochaj Husatczyk z Zarchejczyków, a w podziale jego dwadzieścia i cztery tysiące.
\v 12 Dziewiąty miesiąca dziewiątego był Abijezer Anatotczyk z synów Jemini, a w podziale jego dwadzieścia i cztery tysiące.
\v 13 Dziesiąty miesiąca dziesiątego był Mahary Netofatczyk z Zarchejczyków, a w podziale jego dwadzieścia i cztery tysiące.
\v 14 Jedenasty miesiąca jedenastego był Banajas Faratońszyk z synów Efraimowych, a w podziale jego dwadzieścia i cztery tysiące.
\v 15 Dwunasty miesiąca dwunastego był Haldaj Netofatczyk z Otonijela, a w podziale jego dwadzieścia i cztery tysiące.
\v 16 Nadto nad pokoleniem Izraelskiem byli: Nad Rubeńczykami był książęciem Elijezer, syn Zychrego; nad Symeończykami Sefatyjasz, syn Maachowy;
\v 17 Nad pokoleniem Lewiego Chasabijasz, syn Chemuelowy; nad Aaronowem Sadok;
\v 18 Nad Judowem Elihu z braci Dawidowych; nad Isascharowem Amry, syn Michaelowy;
\v 19 Nad Zabulonowem Jesmajasz, syn Abdyjaszowy; nad Neftalimowem Jerymot, syn Asryjelowy;
\v 20 Nad synami Efraimowymi Hosejasz, syn Azazyjaszowy; nad połową pokolenia Manasesowego Joel, syn Fadajaszowy;
\v 21 Nad drugą połową pokolenia Manasesowego w Galaadzie Iddo, syn Zacharyjaszowy; nad Benjaminowem Jaasyjel, syn Abnerowy.
\v 22 Nad Danowem Azraeel, syn Jerohamowy. Cić są książęta pokoleń Izraelskich.
\v 23 A nie włożył Dawid w liczbę ich żadnego, co miał dwadzieścia lat i niżej; albowiem Pan był powiedział, iż miał rozmnożyć Izraela jako gwiazdy niebieskie.
\v 24 A Joab, syn Sarwii, począł był liczyć, ale nie dokończył, dlatego że był gniew przypadł na Izraela. I nie weszła ta liczba w liczbę kronik o sprawach króla Dawida.
\v 25 A nad skarbami królewskiemi był Asmawet, syn Abdyjelowy; a nad dochodami z pól, z miast, i ze wsi i z zamków był Jonatan, syn Uzyjaszowy;
\v 26 A nad oraczami, którzy uprawiali ziemię, był Ezer, syn Chalubowy.
\v 27 A nad winnicami był Semejasz Ramatczyk; a nad urodzajami winnic i nad piwnicami winnemi Zabdyjasz Zyfmejczyk.
\v 28 A nad oliwnicami, i nad drzewami figowemi, które są w polach, był Balanan Giedertczyk, a nad piwnicami oliwnemi Joas.
\v 29 A nad bydłem, które paszono w Saron, Sytraj Saronitczyk; a nad bydłem po dolinach Safat, syn Adlajego.
\v 30 A nad wielbłądami był Obil Ismaelitczyk, a nad oślicami był Jechdejasz Merończyk.
\v 31 A nad drobnem bydłem Jazys Agiertczyk. Cić wszysct byli przełożonymi nad majętnościami króla Dawida.
\v 32 Ale Jonatan, stryj Dawidowy, był radcą, mąż mądry, i nauczony; ten, i Jehijel, syn Chachmonowy, był z synami królewskimi.
\v 33 Achitofel też był radcą królewskim, a Chusaj Archytczyk przyjacielem królewsskim.
\v 34 A po Achitofelu był Jojada, syn Banajasowy, i Abujatar. A Joab był hetmanem wojska królewskiego.
\c 28
\v 1 Tedy zgromadził Dawid wszystkich książęt Izraelskich, i przedniejszych z każdego pokolenia, i przełożonych nad hyfcami, którzy służyli królowi, i półkowników, i rotmistrzów, i przełożonych nad wszystką majętnością i osiadłością królewską; synów też swoich z komornikami, i z innymi możnymi, i ze wszystkim ludem rycerskim do Jeruzalemu.
\v 2 A powstawszy król Dawid na nogi swoje, rzekł: Słuchajcie mię, bracia moi, i ludu mój! Jam był umyślił w sercu swem, budować dom, gdzieby odpoczywała skrzynia przymierza Paćskiego, i na podnóżek nóg Boga naszego, i zgotowałem był potrzeby ku budowaniu;
\v 3 Ale Bóg rzekł do mnie: Nie będziesz budował domu imieniowi memu, przeto żeś mąż waleczny, i rozlewałeś krew.
\v 4 Ale obrał mię Pan, Bóg Izraelski, ze wszystkiego domu ojca mego, abym był królem nad Izraelem na wieki; bo z Judy obrał księcia, a z narodu Judzkiego dom ojca mego; i z synów ojca mego upodobał mię sobie za króla nad wszystkim Izraelem.
\v 5 A ze wszystkich synów moich (bo mi wiele synów Pan dał) obrał Salomona, syna mego, aby siedział na stolicy królestwa Pańskiego nad Izraelem.
\v 6 I mówił do mnie: Salomon, syn twój, ten zbydyje dom mój, i przysionki moje; albowiemem go sobie obrał za syna, a Ja mu będę za ojca.
\v 7 I umocnię królestwo jego aż na wieki, będzieli statecznym w pełnieniu przykazań moich i sądów moich, jako i dziś.
\v 8 Teraz tedy mówię wam pezed obliczem wszystkiego Izraela, zgromadzenia tego Pańskiego, gdzie słyszy Bóg nasz: Strzeżcie a szukajcie wszystkich rozkazań Pana, Boga waszego, abyście osiedli ziemię dobrą, i zostawili ją w dziedzictwo synom swoim po so bie aż na wieki.
\v 9 A ty Salomonie, synu mój! znaj Boga, ojca twojego, i służ mu sercem doskonałem, i umysłem dobrowolnym; bo wszystkie serca przegląda Pan, i wszystkie zamusły myśli zna. Jeźli go szukać bądziesz, znajdziesz go, a jeźli go opuścisz, odrzuci cię na wieki.
\v 10 Obaczże teraz, iż cię Pan obrał, abyś zbudował dom świątnicy; zmacniajże się a wykonaj to.
\v 11 Tedy oddał Dawid Salomonowi, synowi swemu, wizerunek przysionka, i gmachów jego, i komor jego, i sal jego, i wnętrznych pokojów jego, i domu ubłagalni.
\v 12 Przytem wizerunek wszystkiego, co był umyślił o sieni domu Paćskiego, i o wszystkich gmachach dla skarbów domu Bożego, i dla skarbów rzeczy świętych;
\v 13 I dla pocztów kapłańskich, i Lewitów, i dla wszystkiej pracy w usłudze domu Pańskiego, i dla wszystkiego naczynia służby domu Pańskiego.
\v 14 Także złota pewną wagę na wszystkie naczynia złote, od wszystkiej usługi; srebra także na wszystkie naczynia srebrne pewną wagę, na wszystkie naczynia ku wszelakiej usłudze;
\v 15 Mianowicie pewną wagę na świeczniki złote i na lampy ich złote według wagi każdego świecznika i lamp jego, i na świeczniki srebrne według wagi świecznika każdego i lamp jego, według potrzeby każdego świecznika.
\v 16 Także pewnąwagę złota na stoły chlebów pokładbych, na każdy stół, przytem srebra na stoły srebrne.
\v 17 A na widełki, i na kociołki, i na kadzielnice szczerego złota, i na czasze złote, pewnąwagę na każdą czaszę, i na czasze srebrne, pewną wagę na każdą czaszę.
\v 18 Takżw na ołtarz do kadzeania dał złota szczerego pewną wagę, i złota ku wystawieniu woza Cherubinów, którzyby rozciągnionemi skrzydłami okrywali skrzynię przymierza Pańskiego.
\v 19 To wszystko, rzekł Dawid, opisane z ręki Pańskiej mię doszło, abym zrozumiał wszystko, jako co urobić miano.
\v 20 A tak rzekł Dawid do Salomona, syna swego: Zmacniaj się, a bądź mężnym, czyń to; nie bój się, ani się lękaj; bo Pan Bóg, Bóg mój, będzie z tobą, nie opuści cię, ani cię odstąpi, aż dokończysz wszystkiej roboty służby domu Pańskiego.
\v 21 A oto poczty kapłanów i Lewitów do każdej posługi w domu Bożym bądą z tobą w każdej pracy; każdy ochotny i roztropny przy wszelkiej posłudze, także książęta, i wszystek lud staną na każde rozkazanie twoje.
\c 29
\v 1 Potem mówił król Dawid do wszystkoego zgromadzenia: Salomona, syn mego jedynego, obrał Bóg młodzieńczyka małego. Ale to wielka sprawa; do nie człowiekowi pałac ten, ale Panu Bogu będzie.
\v 2 Ja według najwyższego przemożenia mego nagotowałem na dom Boga mego złota, na naczynie złote, i srebra na srebrne, i miedzi na miedziane, żelaza na żelazne, i drzewa na drewniane, kamienia onychynowego na osadzanie, i kamienia karbunkułowego, i ro zlicznych farb, a wszelakiego kamienia drogiego, i kamienia marmurowego dostatek wielki.
\v 3 Nadto z chęci mojej ku domowi Boga mego osobne złoto i srebro, które mam, oddaję na dom Boga mego, oprócz tego wszystkiego, com zgotował na dom świątnicy;
\v 4 To jest trzy tysiące talentów złota, złota z Ofir, i siedm tysięcy talentów srebra najczystszego na okrycie ścian gmachów;
\v 5 Złota na naczynie złote, a srebra na srebrne, i na wszystkie roboty rąk rzemieślniczych; i jeźliby jeszcze kto chciał co dobrowolnie dziś ofiarować Panu?
\v 6 Tedy dobrowolnie ofiarowali przedniejsi z domów i przedniejsi z pokoleń Izraelskich, i półkownicy, i rotmistrze, i przełożeni nad robotą królewską.
\v 7 I złożyli na usługą domu Bożego złota talentíw pięć tysięcy, i złotych dziesięć tysięcy, a srebra talentów dziesięć tysięcy, i midzi ośmnaście tysięcy talentów, a żelaza sto tysięcy talentów.
\v 8 Ci też co mieli drogie kamienie, dawali je do sksarbu domu Pańskiego, do rąk Jehijela Giersończyka.
\v 9 I weselił się lud, że tak ochotnie ofiaroweali. Albowiem sercem doskonałem chętnie ofiarowali Panu; także i król Dawid weselił się weselem wielkiem.
\v 10 Przetoż błogosławił Dawid Panu przed obliczem wszystkiego zgromadzenia, i rzekł: Błogosławionyś ty Panie, Boże Izraela, ojca naszego, od wieku aż na wieki.
\v 11 Twoja jest, Panie! wielmożność, i moc, i sława, i zwyciąstwo, i cześć, i wszystko na niebie i na ziemi; twoje jest, Panie! królestwo, a tyśjest wywższony nad wszelką zwierzchność.
\v 12 I bogactwa, i sława od ciebie są, a ty panujesz nad wszystkimi, a w rękach twych jest moc i siła, i w ręce twojej jest wywyższyć i utwierdzić wszystko.
\v 13 Teraz tedy, Boże nasz! wyznajemy cię, a chwalimy imię sławy twojej.
\v 14 Albowiem cużem ja, i co jest lud mój, żebyśmyto siły mieli, tobie to dobrowolnie ofiarować? gdyż od ciebie jest wszystko, a z rąk twoich wziąwszy daliśmy tobie.
\v 15 Bośmy my pielgrzymami i przychodniami przed tobą, jako i wszyscy ojcowie nasi; dni nasze na ziemi jako cień, a nie masz czego oczekiwać.
\v 16 O Panie, Boże nasz! ten wszystek dostatek któryśmy zgotowali tobie na budowanie domu imieniowi twemu świętemu, z ręki twojej jest, i twoje jest wszystko.
\v 17 Wiemci ja, Boże mój! iż ty doświadczasz serc a kochasz się w szczerości; przetoż ja w szczerości serca mego, ochotniem pofiarował to wszystko, nawet i lud twój, który się tu znalazł, widziałem z weselem i z ochotą ofiarujący tobie.
\v 18 Panie, Boże Abrahama, Izaaka, i Izraela, ojców naszych! zachowajże na wieki tę chęć, i umysł serca ludu twego, a przygotuj sobie serce ich.
\v 19 Salomonowi też, synowi memu daj serce doskonałe, aby strzegł przykazań twoich, świadectw twoich, i ustaw twoich, i czynił wszystko, i aby zbudował dom, dla któregom potrzebu zgotował.
\v 20 Potem mówił Dawid do wszystkiego zgromadzenia: Błogosławcież teraz Panu, Bogu waszemu. I błogosławiło wszystko zgromadzenie Panu, Bogu ojców sowich, a naczyliwszy się pokłonili się Panu i królowi.
\v 21 I zatem ofiarowali Panu ofiary. Ofiarowali też całopalenia Panu nazajutrz po onym dniu, wołów tysiąc, baranów tysiąc, baranków tysiąc z mokremi ofiarami ich, i inszych ofiar wielkie mnóstwo, za wszystkiego Izraela.
\v 22 I jedli a pili przed Panem dnia onego z weselem wielkiem, a postanowili powtóre królem Salomona, syna Dawidowego, i pomazali go Panu za księcia, a Sadoka za kapłana.
\v 23 A tak usiadł Salomon na stolicy Pańskiej za króla miasto Dawida, ojca swego, i szczęściło mu się, a był mu posłuszny wszystek Izrael.
\v 24 I wszyscy książęta, i możni, także i wszyscy synowie króla Dawida, dali ręce na poddaństwo Salomonowi królowi.
\v 25 I uwielbił Pan Salomona bardzo zacnie przed oczyma wszystkiego Izraela, a dał mu sławę królewskoą, jakiej żaden król przed nim nie miał w Izraelu.
\v 26 A tak Dawid, syn Isajego, królował nad wszystkim Izraelem.
\v 27 A dni, których królował nad Izraelem, było czterdzieści lat; w Hebronie królował siedm lat; a w Jeruzalemie królował trzydzieści i trzy lata.
\v 28 I umarł w starości dobrej, pełen dni, bogactw i sławy: a królował Salomon, syn jego, miasto niego.
\v 29 A sprawy króla Dawida pierwsze i ostatnie, oto są zapisane w księgach Samuela widzącego, i w księdze Natana proroka, i w skiędze Gada widzącego;
\v 30 Ze wszystkiem królowaniem jego, i możnością jego, i z czasami, które za niego i za Izraela, i za wszystkich królestw ziemskich przeszły.
